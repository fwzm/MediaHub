<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    MediaHub visual foundation.

    One restrained dark palette, one accent, a four-step type scale and a small set of
    control styles. Pages consume the tokens below rather than hard-coding colours, so a
    single change here re-tints the whole product.

    The palette is deliberately low-contrast in the surfaces (near-black through #1C2129)
    and high-contrast in the text, which is what keeps a video library readable while the
    artwork supplies the colour.
  -->

  <!-- ================================================================ colour tokens -->
  <Color x:Key="MediaHubBgColor">#FF0A0C10</Color>
  <Color x:Key="MediaHubBgRaisedColor">#FF0E1116</Color>
  <Color x:Key="MediaHubSurfaceColor">#FF15191F</Color>
  <Color x:Key="MediaHubSurfaceHoverColor">#FF1C2129</Color>
  <Color x:Key="MediaHubSurfaceActiveColor">#FF222831</Color>
  <Color x:Key="MediaHubStrokeColor">#FF232A33</Color>
  <Color x:Key="MediaHubStrokeStrongColor">#FF34404C</Color>
  <Color x:Key="MediaHubTextPrimaryColor">#FFF2F5F8</Color>
  <Color x:Key="MediaHubTextSecondaryColor">#FF9EA9B5</Color>
  <Color x:Key="MediaHubTextTertiaryColor">#FF69737F</Color>
  <Color x:Key="MediaHubAccentColor">#FF3FC9B8</Color>
  <Color x:Key="MediaHubAccentTextColor">#FF04110E</Color>
  <Color x:Key="MediaHubAccentSoftColor">#263FC9B8</Color>
  <Color x:Key="MediaHubDangerColor">#FFE4695E</Color>

  <!-- Brand ramp: toggles, sliders and focus rings all read from these. -->
  <Color x:Key="SystemAccentColor">#FF3FC9B8</Color>
  <Color x:Key="SystemAccentColorLight1">#FF62D6C8</Color>
  <Color x:Key="SystemAccentColorLight2">#FF8AE2D7</Color>
  <Color x:Key="SystemAccentColorLight3">#FFB4EDE6</Color>
  <Color x:Key="SystemAccentColorDark1">#FF35AA9C</Color>
  <Color x:Key="SystemAccentColorDark2">#FF2B8B80</Color>
  <Color x:Key="SystemAccentColorDark3">#FF216C63</Color>

  <SolidColorBrush x:Key="MediaHubAccentBrush" Color="{StaticResource MediaHubAccentColor}" />
  <SolidColorBrush x:Key="MediaHubAccentSoftBrush" Color="{StaticResource MediaHubAccentSoftColor}" />
  <SolidColorBrush x:Key="MediaHubAccentTextBrush" Color="{StaticResource MediaHubAccentTextColor}" />
  <SolidColorBrush x:Key="MediaHubBgBrush" Color="{StaticResource MediaHubBgColor}" />
  <SolidColorBrush x:Key="MediaHubBgRaisedBrush" Color="{StaticResource MediaHubBgRaisedColor}" />
  <SolidColorBrush x:Key="MediaHubSurfaceBrush" Color="{StaticResource MediaHubSurfaceColor}" />
  <SolidColorBrush x:Key="MediaHubSurfaceHoverBrush" Color="{StaticResource MediaHubSurfaceHoverColor}" />
  <SolidColorBrush x:Key="MediaHubSurfaceActiveBrush" Color="{StaticResource MediaHubSurfaceActiveColor}" />
  <SolidColorBrush x:Key="MediaHubBorderBrush" Color="{StaticResource MediaHubStrokeColor}" />
  <SolidColorBrush x:Key="MediaHubStrokeStrongBrush" Color="{StaticResource MediaHubStrokeStrongColor}" />
  <SolidColorBrush x:Key="MediaHubTextPrimaryBrush" Color="{StaticResource MediaHubTextPrimaryColor}" />
  <SolidColorBrush x:Key="MediaHubTextSecondaryBrush" Color="{StaticResource MediaHubTextSecondaryColor}" />
  <SolidColorBrush x:Key="MediaHubTextTertiaryBrush" Color="{StaticResource MediaHubTextTertiaryColor}" />
  <SolidColorBrush x:Key="MediaHubDangerBrush" Color="{StaticResource MediaHubDangerColor}" />

  <!-- ================================================================ glass layer -->
  <!--
    Glass is one window-level backdrop (Mica/Acrylic) plus the translucent veils below - not a blur
    brush per element. Per-element blur re-samples the app's own visual tree for every card, which is
    what makes a poster grid drop frames; a veil is a plain alpha composite.

    These veils are also the fallback: the shell paints MediaHubBgBrush behind the whole window, so
    when the backdrop is unavailable (transparency disabled, high contrast, Remote Desktop, Windows 10)
    the same translucent colours composite over that solid and land on the existing palette instead of
    turning grey. Nothing here needs a second "solid mode" stylesheet.
  -->
  <Color x:Key="MediaHubGlassPaneColor">#A61D2431</Color>
  <Color x:Key="MediaHubGlassSurfaceColor">#99222A34</Color>
  <!-- Stacked planes and popups need more coverage than an in-page card: the thing behind them is
       unknown artwork or video, not the shell's own tinted page. -->
  <Color x:Key="MediaHubGlassDialogColor">#F2181E27</Color>
  <Color x:Key="MediaHubGlassFlyoutColor">#F71A202A</Color>
  <Color x:Key="MediaHubGlassToolTipColor">#FA1B222C</Color>
  <Color x:Key="MediaHubGlassStrokeColor">#2EFFFFFF</Color>
  <!-- A vertical sheen, not a flat veil: the light falls off towards the bottom of the page, which is
       what separates frosted glass from a plain translucent rectangle once the palette is this dark. -->
  <LinearGradientBrush x:Key="MediaHubGlassPageBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#A81E242E" Offset="0" />
    <GradientStop Color="#C40A0C10" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MediaHubGlassPaneBrush" Color="{StaticResource MediaHubGlassPaneColor}" />
  <SolidColorBrush x:Key="MediaHubGlassSurfaceBrush" Color="{StaticResource MediaHubGlassSurfaceColor}" />
  <!-- The hairline that separates two stacked glass planes; brighter than the solid-mode stroke
       because it has to read against a blurred, unknown luminance behind it. -->
  <SolidColorBrush x:Key="MediaHubGlassStrokeBrush" Color="{StaticResource MediaHubGlassStrokeColor}" />

  <!-- ================================================================ shape scale -->
  <!--
    One roundness scale for the whole product: pill for actions, 10 for anything that holds a value
    or a row, 14 for a card, 16 for a floating surface. WinUI looks ControlCornerRadius and
    OverlayCornerRadius up by name from every default template, so overriding them rounds inputs,
    list rows, menus, flyouts and dialogs at once - the alternative is retemplating each control,
    which is how a UI ends up rounded in one place and square in another.
  -->
  <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
  <CornerRadius x:Key="MediaHubRadiusPill">999</CornerRadius>
  <CornerRadius x:Key="MediaHubRadiusField">10</CornerRadius>
  <CornerRadius x:Key="MediaHubRadiusCard">14</CornerRadius>
  <CornerRadius x:Key="MediaHubRadiusOverlay">16</CornerRadius>

  <!-- ================================================================ glass thickness -->
  <!--
    Depth on a dark surface comes from light, not from transparency: a raised pane is lighter at the
    top, darker at the bottom, has a bright top rim and a dark inner edge below it. That is the whole
    trick - none of this needs a blur, and all of it survives at 60fps while scrolling.
  -->
  <LinearGradientBrush x:Key="MediaHubGlassRaisedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#B32B3442" Offset="0" />
    <GradientStop Color="#8C12161C" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MediaHubGlassRaisedHoverBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#C4374150" Offset="0" />
    <GradientStop Color="#A6171C24" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MediaHubGlassRaisedPressedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#8C12161C" Offset="0" />
    <GradientStop Color="#B31C222B" Offset="1" />
  </LinearGradientBrush>
  <!-- Edge: bright along the top rim, dark along the bottom rim. A single flat stroke cannot do this,
       and it is the strongest "slab of glass" cue in the theme. -->
  <LinearGradientBrush x:Key="MediaHubGlassEdgeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#59FFFFFF" Offset="0" />
    <GradientStop Color="#24FFFFFF" Offset="0.42" />
    <GradientStop Color="#1A000000" Offset="0.58" />
    <GradientStop Color="#4D000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MediaHubGlassEdgeHoverBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#80FFFFFF" Offset="0" />
    <GradientStop Color="#33FFFFFF" Offset="0.42" />
    <GradientStop Color="#1A000000" Offset="0.58" />
    <GradientStop Color="#4D000000" Offset="1" />
  </LinearGradientBrush>
  <!-- The 1px specular line just inside the top rim of a raised pane. -->
  <LinearGradientBrush x:Key="MediaHubTopSheenBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0" />
    <GradientStop Color="#66FFFFFF" Offset="0.28" />
    <GradientStop Color="#66FFFFFF" Offset="0.72" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!--
    Popups (content dialogs, flyouts, menus, tooltips) are separate composition surfaces: the app's
    backdrop does not reach behind them, so they cannot rely on the window material. They get their
    own, stronger veil - a dialog has to stay readable over whatever it was opened on top of, and
    that can be a poster, a bright frame of video or the desktop. The hairline is the same highlight
    edge as the cards, which is what makes a dialog read as another pane of the same glass rather
    than as a flat system dialog dropped on top of the app.
  -->
  <SolidColorBrush x:Key="MediaHubGlassDialogBrush" Color="{StaticResource MediaHubGlassDialogColor}" />
  <SolidColorBrush x:Key="MediaHubGlassFlyoutBrush" Color="{StaticResource MediaHubGlassFlyoutColor}" />
  <SolidColorBrush x:Key="MediaHubGlassToolTipBrush" Color="{StaticResource MediaHubGlassToolTipColor}" />

  <!-- WinUI looks these keys up by name from the default control templates, so overriding them here
       restyles every dialog, flyout and tooltip without retemplating a control - which would have to
       be redone on every WinUI upgrade and could silently drop behaviour the default template owns. -->
  <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource MediaHubGlassDialogColor}" />
  <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource MediaHubGlassStrokeColor}" />
  <!-- The smoke is deeper than the default so the dialog plane separates from the page behind it. -->
  <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#8C0A0C10" />
  <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource MediaHubGlassFlyoutColor}" />
  <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{StaticResource MediaHubGlassStrokeColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource MediaHubGlassFlyoutColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource MediaHubGlassStrokeColor}" />
  <!-- A tooltip is a few words over an unknown pixel: almost opaque, or the text disappears into
       the artwork it is describing. -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource MediaHubGlassToolTipColor}" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource MediaHubGlassStrokeColor}" />

  <!-- Artwork wells. A gradient rather than a flat grey keeps an empty poster from looking broken. -->
  <LinearGradientBrush x:Key="MediaHubPosterPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1B2129" Offset="0" />
    <GradientStop Color="#FF10141A" Offset="1" />
  </LinearGradientBrush>

  <!-- ================================================================ player chrome -->
  <!-- Overlay chrome sits on top of video, so it must be legible regardless of the frame behind it. -->
  <SolidColorBrush x:Key="MediaHubOverlayTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="MediaHubOverlaySubtleTextBrush" Color="#B8FFFFFF" />
  <SolidColorBrush x:Key="MediaHubOverlayHairlineBrush" Color="#1FFFFFFF" />

  <LinearGradientBrush x:Key="MediaHubTopOverlayBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#F20A0C10" Offset="0" />
    <GradientStop Color="#C40A0C10" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MediaHubBottomOverlayBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#B80A0C10" Offset="0" />
    <GradientStop Color="#F50A0C10" Offset="1" />
  </LinearGradientBrush>

  <!-- The side rail is a glass plane beside the video, not over it: the sheen runs top-to-bottom so
       the rail reads as a surface the video sits against. It stays near-opaque because every row in
       it is text, and the video next to it can be any brightness. -->
  <LinearGradientBrush x:Key="MediaHubPlayerPanelBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#F2151A21" Offset="0" />
    <GradientStop Color="#FA0A0C10" Offset="1" />
  </LinearGradientBrush>

  <!-- NavigationView panes: the pane is glass over the shell backdrop, with a single hairline. -->
  <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource MediaHubGlassPaneColor}" />
  <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource MediaHubGlassPaneColor}" />
  <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{StaticResource MediaHubGlassPaneColor}" />
  <!-- Transparent so the page's own veil is the only tint over the backdrop; an opaque content
       background here would put a second dark layer under every page and cancel the glass. -->
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

  <!-- ================================================================ type scale -->
  <Style x:Key="MediaHubDisplay" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="CharacterSpacing" Value="-20" />
  </Style>

  <Style x:Key="MediaHubPageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="CharacterSpacing" Value="-10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="MediaHubSectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style x:Key="MediaHubSubsectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style x:Key="MediaHubBody" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
  </Style>

  <Style x:Key="MediaHubCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextSecondaryBrush}" />
  </Style>

  <Style x:Key="MediaHubMono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextSecondaryBrush}" />
  </Style>

  <!-- ================================================================ surfaces -->
  <Style x:Key="MediaHubCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MediaHubGlassRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusCard}" />
  </Style>

  <Style x:Key="MediaHubPosterFrame" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MediaHubPosterPlaceholderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusField}" />
  </Style>

  <!-- ================================================================ buttons -->
  <!-- Accent with the same top-lit fall-off as the glass panes, so the primary action reads as a
       lit object rather than a flat swatch. -->
  <LinearGradientBrush x:Key="MediaHubAccentRaisedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF52D8C7" Offset="0" />
    <GradientStop Color="#FF2E9A8E" Offset="1" />
  </LinearGradientBrush>

  <!-- Solid accent: one primary action per surface. -->
  <Style x:Key="MediaHubPrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource MediaHubAccentRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubAccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusPill}" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="Lift" />
            </Grid.RenderTransform>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- 1px specular line: the top rim catches light, which is what makes the pill look
                 like a piece of glass instead of a coloured rectangle. -->
            <Border Height="1" Margin="10,1,10,0" VerticalAlignment="Top" CornerRadius="1"
                    Background="{StaticResource MediaHubTopSheenBrush}" Opacity="0.55" />
            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="-1.5" Duration="0:0:0.10">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0.5" Duration="0:0:0.06">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.82" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive action. Same geometry and motion as the primary; only the material is red, which
       keeps the role readable without introducing a second button shape. -->
  <Style x:Key="MediaHubDangerButton" TargetType="Button" BasedOn="{StaticResource MediaHubPrimaryButton}">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#FFD0564B" Offset="0" />
          <GradientStop Color="#FFA83A32" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="#FFFFF3F1" />
  </Style>

  <!-- Quiet button: outlined, for secondary actions that sit beside a primary one. -->
  <Style x:Key="MediaHubGhostButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource MediaHubGlassRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusPill}" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="Lift" />
            </Grid.RenderTransform>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border Height="1" Margin="12,1,12,0" VerticalAlignment="Top" CornerRadius="1"
                    Background="{StaticResource MediaHubTopSheenBrush}" Opacity="0.4" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="-1.5" Duration="0:0:0.10">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Fill.Background" Value="{StaticResource MediaHubGlassRaisedHoverBrush}" />
                    <Setter Target="Fill.BorderBrush" Value="{StaticResource MediaHubGlassEdgeHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0.5" Duration="0:0:0.06">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Fill.Background" Value="{StaticResource MediaHubGlassRaisedPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon-only button: transparent until hovered, so toolbars stay quiet. Round by construction. -->
  <Style x:Key="MediaHubIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusPill}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="Hover" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderThickness="1" BorderBrush="Transparent" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Background" Value="{StaticResource MediaHubGlassRaisedHoverBrush}" />
                    <Setter Target="Hover.BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Background" Value="{StaticResource MediaHubGlassRaisedPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.3" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Large surface button: the home screen's quick entries. A tile, not a control-sized action, so
       it keeps the card radius instead of becoming a stadium. -->
  <Style x:Key="MediaHubCardButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource MediaHubGlassRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusCard}" />
    <Setter Property="Padding" Value="18,15" />
    <Setter Property="MinWidth" Value="176" />
    <Setter Property="MinHeight" Value="76" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="Lift" />
            </Grid.RenderTransform>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border Height="1" Margin="14,1,14,0" VerticalAlignment="Top" CornerRadius="1"
                    Background="{StaticResource MediaHubTopSheenBrush}" Opacity="0.45" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="-2" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Fill.Background" Value="{StaticResource MediaHubGlassRaisedHoverBrush}" />
                    <Setter Target="Fill.BorderBrush" Value="{StaticResource MediaHubGlassEdgeHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Storyboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                       To="0.5" Duration="0:0:0.07">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualState.Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Fill.Background" Value="{StaticResource MediaHubGlassRaisedPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ list items -->
  <Style x:Key="MediaHubGridViewItem" TargetType="GridViewItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style x:Key="MediaHubListViewItem" TargetType="ListViewItem">
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusField}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ================================================================ form rows -->
  <Style x:Key="MediaHubFieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="MediaHubExpander" TargetType="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource MediaHubGlassRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubGlassEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediaHubRadiusCard}" />
    <Setter Property="Padding" Value="18,4,18,10" />
  </Style>

  <!-- ================================================================ page states -->
  <!--
    Empty, loading and failure are one visual family. Every page used to draw its own version of
    these, so "nothing here yet" and "the read failed" were told apart only by reading the sentence.
    A state is now an icon, a short title and one line of detail, with at most one action.
  -->
  <Style x:Key="MediaHubStateIcon" TargetType="Border">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Background" Value="{StaticResource MediaHubSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MediaHubBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="MediaHubStateGlyph" TargetType="FontIcon">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Failure keeps the same shape but the ring and glyph carry the danger colour. -->
  <Style x:Key="MediaHubStateIconError" TargetType="Border" BasedOn="{StaticResource MediaHubStateIcon}">
    <Setter Property="Background" Value="#1AE4695E" />
    <Setter Property="BorderBrush" Value="#33E4695E" />
  </Style>

  <Style x:Key="MediaHubStateGlyphError" TargetType="FontIcon" BasedOn="{StaticResource MediaHubStateGlyph}">
    <Setter Property="Foreground" Value="{StaticResource MediaHubDangerBrush}" />
  </Style>

  <Style x:Key="MediaHubStateTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MediaHubStateDescription" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{StaticResource MediaHubTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>

  <!-- ================================================================ skeleton -->
  <LinearGradientBrush x:Key="MediaHubSkeletonBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1E242C" Offset="0" />
    <GradientStop Color="#FF151A20" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="MediaHubSkeletonBlock" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MediaHubSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <!--
    Placeholder tiles. They are sized like the real tile so the layout does not jump when the first
    page arrives, and they carry no text at all - a skeleton that spells out fake titles reads as
    broken data rather than as "still loading".
  -->
  <DataTemplate x:Key="MediaHubPosterSkeleton">
    <StackPanel Width="168" Margin="0,0,16,18" Spacing="8">
      <Border Width="168" Height="252" CornerRadius="10" Background="{StaticResource MediaHubSkeletonBrush}" />
      <Border Height="12" Width="132" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
      <Border Height="10" Width="84" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="MediaHubLandscapeSkeleton">
    <StackPanel Width="300" Margin="0,0,16,18" Spacing="8">
      <Border Width="300" Height="169" CornerRadius="10" Background="{StaticResource MediaHubSkeletonBrush}" />
      <Border Height="12" Width="220" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
    </StackPanel>
  </DataTemplate>

  <!-- Row placeholder for list pages (library folders, sources, playlists). -->
  <DataTemplate x:Key="MediaHubRowSkeleton">
    <Grid Margin="0,0,0,10" Padding="18" ColumnSpacing="16" Height="78"
          Background="{StaticResource MediaHubSurfaceBrush}" CornerRadius="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
              Background="{StaticResource MediaHubSkeletonBrush}" />
      <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
        <Border Height="13" Width="220" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
        <Border Height="10" Width="320" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- Card placeholder for the library tiles. -->
  <DataTemplate x:Key="MediaHubCardSkeleton">
    <Border Width="300" Height="86" Margin="0,0,14,14" Padding="16"
            Background="{StaticResource MediaHubSurfaceBrush}"
            BorderBrush="{StaticResource MediaHubBorderBrush}" BorderThickness="1" CornerRadius="10">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                Background="{StaticResource MediaHubSkeletonBrush}" />
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <Border Height="13" Width="150" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
          <Border Height="10" Width="100" HorizontalAlignment="Left" Style="{StaticResource MediaHubSkeletonBlock}" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Skeleton grid panel used by every poster page. ItemsSource is filled in code with placeholders. -->
  <ItemsPanelTemplate x:Key="MediaHubSkeletonWrapPanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="306" />
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="MediaHubSkeletonLandscapePanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="316" ItemHeight="220" />
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="MediaHubSkeletonCardPanel">
    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="314" ItemHeight="100" />
  </ItemsPanelTemplate>

  <!-- ================================================================ pointer states -->
  <!--
    Grid/list rows sit on the dark plane, so the hover has to be a light veil rather than a tinted
    fill: it stays legible over artwork of any colour. Pressed deepens it slightly; the accent is
    reserved for focus and selection.
  -->
  <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
  <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
  <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#22FFFFFF" />

  <!-- ================================================================ form controls -->
  <!--
    Inputs, pickers, sliders and scrollbars come from WinUI templates, so they are re-tinted through
    the resource keys those templates look up. This is what keeps a text box from staying a flat
    solid plate while the card next to it has glass fall-off.
  -->
  <SolidColorBrush x:Key="TextControlBackground" Color="#8C1E2530" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#A3222935" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B3242C38" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#6610151B" />
  <LinearGradientBrush x:Key="TextControlBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#40FFFFFF" Offset="0" />
    <GradientStop Color="#14FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TextControlBorderBrushPointerOver" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#66FFFFFF" Offset="0" />
    <GradientStop Color="#1FFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource MediaHubAccentColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource MediaHubTextTertiaryColor}" />

  <SolidColorBrush x:Key="ComboBoxBackground" Color="#8C1E2530" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#A3222935" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#B3242C38" />
  <LinearGradientBrush x:Key="ComboBoxBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#40FFFFFF" Offset="0" />
    <GradientStop Color="#14FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource MediaHubTextSecondaryColor}" />

  <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource MediaHubAccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource MediaHubAccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource SystemAccentColorLight1}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource SystemAccentColorDark1}" />

  <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#59FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
  <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#40FFFFFF" />
</ResourceDictionary>
