<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- MediaHub identity: a single teal-leaning accent that reads correctly on both themes. -->
  <Color x:Key="MediaHubAccentColor">#FF2FB6A8</Color>
  <SolidColorBrush x:Key="MediaHubAccentBrush" Color="#FF2FB6A8" />
  <SolidColorBrush x:Key="MediaHubSurfaceBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="MediaHubBorderBrush" Color="#22FFFFFF" />

  <!-- Overlay chrome sits on top of video, so it must be legible regardless of the frame behind it. -->
  <SolidColorBrush x:Key="MediaHubOverlayBrush" Color="#E6101417" />
  <SolidColorBrush x:Key="MediaHubOverlayTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="MediaHubOverlaySubtleTextBrush" Color="#B3FFFFFF" />

  <Style x:Key="MediaHubSectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="MediaHubCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
</ResourceDictionary>
