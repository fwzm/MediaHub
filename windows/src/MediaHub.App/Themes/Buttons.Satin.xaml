<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaHub.App.Controls">

  <!--
    方案 B · 缎面（Satin Alloy）

    What it borrows: Fluent treats depth as elevation. A surface sits a millimetre above the plane,
    is lit broadly rather than specularly, and changes state by luminance plus a small vertical
    travel - not by growing a highlight. The edge is a machined 1px ring, solid rather than glowing,
    which is what keeps it crisp on a dark page.

    Deliberately absent: blur, grain, and liquid-glass lensing. This is the calm, tool-like option.
  -->

  <LinearGradientBrush x:Key="SatinSurfaceBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF2A323D" Offset="0" />
    <GradientStop Color="#FF1A2028" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatinPrimaryBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF4FD8C6" Offset="0" />
    <GradientStop Color="#FF2B8F84" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatinDangerBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FFB8423A" Offset="0" />
    <GradientStop Color="#FF8E2E28" Offset="1" />
  </LinearGradientBrush>

  <!-- A solid machined edge. It does not fade to transparent in the middle the way the glass rim
       does: a metal part has a continuous boundary, and the eye uses that continuity to read it as
       an object rather than a rectangle of light. -->
  <LinearGradientBrush x:Key="SatinEdgeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF3E4957" Offset="0" />
    <GradientStop Color="#FF232A33" Offset="0.5" />
    <GradientStop Color="#FF141920" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatinInnerEdgeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#2EFFFFFF" Offset="0" />
    <GradientStop Color="#0FFFFFFF" Offset="0.4" />
    <GradientStop Color="#00000000" Offset="0.62" />
    <GradientStop Color="#30000000" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatinInnerEdgeHoverBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#47FFFFFF" Offset="0" />
    <GradientStop Color="#1AFFFFFF" Offset="0.4" />
    <GradientStop Color="#00000000" Offset="0.62" />
    <GradientStop Color="#30000000" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatinInnerEdgePressedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#1FFFFFFF" Offset="0" />
    <GradientStop Color="#0AFFFFFF" Offset="0.4" />
    <GradientStop Color="#00000000" Offset="0.62" />
    <GradientStop Color="#47000000" Offset="1" />
  </LinearGradientBrush>

  <!-- Broad and soft, not a hot spot: this is bead-blasted metal, not polished glass. -->
  <RadialGradientBrush x:Key="SatinSheenBrush"
                       Center="0.5,0" GradientOrigin="0.5,0"
                       RadiusX="1.15" RadiusY="0.85"
                       MappingMode="RelativeToBoundingBox">
    <GradientStop Color="#17FFFFFF" Offset="0" />
    <GradientStop Color="#0AFFFFFF" Offset="0.45" />
    <GradientStop Color="#00FFFFFF" Offset="0.86" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="SatinVeilHoverBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SatinVeilPressedBrush" Color="#26000000" />

  <SolidColorBrush x:Key="SatinIconSurfaceBrush" Color="#FF2A323D" />
  <SolidColorBrush x:Key="SatinIconPressedBrush" Color="#FF1C222A" />

  <SolidColorBrush x:Key="SatinDisabledSurfaceBrush" Color="#FF1E242C" />
  <SolidColorBrush x:Key="SatinDisabledEdgeBrush" Color="#FF2C343E" />
  <SolidColorBrush x:Key="SatinDisabledTextBrush" Color="#FF79838F" />

  <SolidColorBrush x:Key="SatinFocusBrush" Color="#FF3FC9B8" />
  <SolidColorBrush x:Key="SatinFocusHaloBrush" Color="#00000000" />
  <SolidColorBrush x:Key="SatinGlowBrush" Color="#00000000" />

  <!-- ============================================================ surface template -->

  <ControlTemplate x:Key="SatinSurface" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <CompositeTransform x:Name="Motion" />
      </Grid.RenderTransform>

      <!-- The contact shadow: a 1px offset plate under the bottom edge. It is the elevation cue
           that survives without a blur brush or a composition shadow. -->
      <Border x:Name="Shadow" Margin="1,2,1,-1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="#66000000" IsHitTestVisible="False" />

      <Border x:Name="Glow" Margin="-1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="Transparent" BorderThickness="1"
              BorderBrush="{StaticResource SatinGlowBrush}" IsHitTestVisible="False" />

      <Border x:Name="Fill" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}" />

      <Border x:Name="Sheen" Margin="1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="{StaticResource SatinSheenBrush}" IsHitTestVisible="False" />

      <Border x:Name="InnerEdge" Margin="1" CornerRadius="{TemplateBinding CornerRadius}"
              BorderBrush="{StaticResource SatinInnerEdgeBrush}" BorderThickness="1"
              IsHitTestVisible="False" />

      <Border x:Name="Veil" Margin="1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="Transparent" IsHitTestVisible="False" />

      <ContentPresenter x:Name="Presenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

      <Border x:Name="FocusHalo" Margin="-7" CornerRadius="{TemplateBinding CornerRadius}"
              BorderThickness="3" BorderBrush="{StaticResource SatinFocusHaloBrush}"
              Visibility="Collapsed" IsHitTestVisible="False" />
      <Border x:Name="FocusRing" Margin="-4" CornerRadius="{TemplateBinding CornerRadius}"
              BorderThickness="2" BorderBrush="{StaticResource SatinFocusBrush}"
              Visibility="Collapsed" IsHitTestVisible="False" />

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="0" Duration="0:0:0.14">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                 To="0.55" Duration="0:0:0.14" />
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Veil.Background" Value="Transparent" />
              <Setter Target="Sheen.Opacity" Value="1" />
              <Setter Target="InnerEdge.Opacity" Value="1" />
              <Setter Target="InnerEdge.BorderBrush" Value="{StaticResource SatinInnerEdgeBrush}" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="PointerOver">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="-1" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                 To="0.8" Duration="0:0:0.12" />
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Veil.Background" Value="{StaticResource SatinVeilHoverBrush}" />
              <Setter Target="Sheen.Opacity" Value="1" />
              <Setter Target="InnerEdge.Opacity" Value="1" />
              <Setter Target="InnerEdge.BorderBrush" Value="{StaticResource SatinInnerEdgeHoverBrush}" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="Pressed">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="0.5" Duration="0:0:0.08">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                 To="0.3" Duration="0:0:0.08" />
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Veil.Background" Value="{StaticResource SatinVeilPressedBrush}" />
              <Setter Target="Sheen.Opacity" Value="0.45" />
              <Setter Target="InnerEdge.Opacity" Value="1" />
              <Setter Target="InnerEdge.BorderBrush" Value="{StaticResource SatinInnerEdgePressedBrush}" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Fill.Background" Value="{StaticResource SatinDisabledSurfaceBrush}" />
              <Setter Target="Fill.BorderBrush" Value="{StaticResource SatinDisabledEdgeBrush}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource SatinDisabledTextBrush}" />
              <Setter Target="Shadow.Opacity" Value="0" />
              <Setter Target="Veil.Background" Value="Transparent" />
              <Setter Target="Sheen.Opacity" Value="0" />
              <Setter Target="InnerEdge.Opacity" Value="0" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>

        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Unfocused">
            <VisualState.Setters>
              <Setter Target="FocusRing.Visibility" Value="Collapsed" />
              <Setter Target="FocusHalo.Visibility" Value="Collapsed" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Target="FocusRing.Visibility" Value="Visible" />
              <Setter Target="FocusHalo.Visibility" Value="Visible" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- ============================================================ icon template -->

  <ControlTemplate x:Key="SatinIcon" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <CompositeTransform x:Name="Motion" />
      </Grid.RenderTransform>

      <Border x:Name="Shadow" Margin="1,2,1,-1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="#66000000" Opacity="0" IsHitTestVisible="False" />

      <Border x:Name="Hover" Background="Transparent" BorderBrush="Transparent"
              BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" />
      <Border x:Name="Sheen" Margin="1" CornerRadius="{TemplateBinding CornerRadius}"
              Background="{StaticResource SatinSheenBrush}" Opacity="0" IsHitTestVisible="False" />
      <Border x:Name="InnerEdge" Margin="1" CornerRadius="{TemplateBinding CornerRadius}"
              BorderBrush="{StaticResource SatinInnerEdgeHoverBrush}" BorderThickness="1"
              Opacity="0" IsHitTestVisible="False" />

      <ContentPresenter x:Name="Presenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />

      <Border x:Name="FocusHalo" Margin="-6" CornerRadius="{TemplateBinding CornerRadius}"
              BorderThickness="3" BorderBrush="{StaticResource SatinFocusHaloBrush}"
              Visibility="Collapsed" IsHitTestVisible="False" />
      <Border x:Name="FocusRing" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}"
              BorderThickness="2" BorderBrush="{StaticResource SatinFocusBrush}"
              Visibility="Collapsed" IsHitTestVisible="False" />

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="0" Duration="0:0:0.14">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Hover.Background" Value="Transparent" />
              <Setter Target="Hover.BorderBrush" Value="Transparent" />
              <Setter Target="Shadow.Opacity" Value="0" />
              <Setter Target="Sheen.Opacity" Value="0" />
              <Setter Target="InnerEdge.Opacity" Value="0" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="PointerOver">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="-1" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                 To="0.7" Duration="0:0:0.12" />
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Hover.Background" Value="{StaticResource SatinIconSurfaceBrush}" />
              <Setter Target="Hover.BorderBrush" Value="{StaticResource SatinEdgeBrush}" />
              <Setter Target="Sheen.Opacity" Value="1" />
              <Setter Target="InnerEdge.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="Pressed">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="TranslateY"
                                 To="0.5" Duration="0:0:0.08">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                 To="0.2" Duration="0:0:0.08" />
              </Storyboard>
            </VisualState.Storyboard>
            <VisualState.Setters>
              <Setter Target="Hover.Background" Value="{StaticResource SatinIconPressedBrush}" />
              <Setter Target="Hover.BorderBrush" Value="{StaticResource SatinEdgeBrush}" />
              <Setter Target="Sheen.Opacity" Value="0.4" />
              <Setter Target="InnerEdge.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Hover.Background" Value="Transparent" />
              <Setter Target="Hover.BorderBrush" Value="Transparent" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource SatinDisabledTextBrush}" />
              <Setter Target="Shadow.Opacity" Value="0" />
              <Setter Target="Sheen.Opacity" Value="0" />
              <Setter Target="InnerEdge.Opacity" Value="0" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>

        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Unfocused">
            <VisualState.Setters>
              <Setter Target="FocusRing.Visibility" Value="Collapsed" />
              <Setter Target="FocusHalo.Visibility" Value="Collapsed" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Target="FocusRing.Visibility" Value="Visible" />
              <Setter Target="FocusHalo.Visibility" Value="Visible" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- ============================================================ styles -->

  <Style x:Key="MediaHubPrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SatinPrimaryBrush}" />
    <Setter Property="Foreground" Value="#FF04110E" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="controls:ButtonChrome.TrackFocus" Value="True" />
    <Setter Property="Template" Value="{StaticResource SatinSurface}" />
  </Style>

  <Style x:Key="MediaHubGhostButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SatinSurfaceBrush}" />
    <Setter Property="Foreground" Value="#FFF2F5F8" />
    <Setter Property="BorderBrush" Value="{StaticResource SatinEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="controls:ButtonChrome.TrackFocus" Value="True" />
    <Setter Property="Template" Value="{StaticResource SatinSurface}" />
  </Style>

  <Style x:Key="MediaHubDangerButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SatinDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFF3F1" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="controls:ButtonChrome.TrackFocus" Value="True" />
    <Setter Property="Template" Value="{StaticResource SatinSurface}" />
  </Style>

  <Style x:Key="MediaHubIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#FFF2F5F8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="controls:ButtonChrome.TrackFocus" Value="True" />
    <Setter Property="Template" Value="{StaticResource SatinIcon}" />
  </Style>

  <Style x:Key="MediaHubCardButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SatinSurfaceBrush}" />
    <Setter Property="Foreground" Value="#FFF2F5F8" />
    <Setter Property="BorderBrush" Value="{StaticResource SatinEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18,15" />
    <Setter Property="MinWidth" Value="176" />
    <Setter Property="MinHeight" Value="76" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="controls:ButtonChrome.TrackFocus" Value="True" />
    <Setter Property="Template" Value="{StaticResource SatinSurface}" />
  </Style>

</ResourceDictionary>
