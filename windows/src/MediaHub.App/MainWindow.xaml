<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MediaHub">

  <!-- Dark is a product decision here, not a system preference: the shell is a media surface and
       the artwork supplies the colour. It is fixed at the root so every page, flyout and dialog
       inherits one palette. -->
  <Grid x:Name="RootGrid" Background="{StaticResource MediaHubBgBrush}" RequestedTheme="Dark">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ShellWidthStates">
        <VisualState x:Name="ShellWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="760" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="ShellNarrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <!-- Below 760px NavigationView switches to its minimal pane and floats the hamburger
                 over the content. Reserving its height here keeps it off every page's title, instead
                 of teaching each page about a shell-owned control. -->
            <Setter Target="ShellFrame.Margin" Value="0,44,0,0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- A real menu bar, because "open a file" is a shell-level action rather than a library one:
         the user should not have to be inside a particular page for it to be reachable.
         The hairline under it is what makes the menu read as a separate glass plane from the page
         below it; without the edge the two translucent layers merge into one flat rectangle. -->
    <Border Grid.Row="0" Background="{StaticResource MediaHubGlassPaneBrush}"
            BorderBrush="{StaticResource MediaHubGlassStrokeBrush}" BorderThickness="0,0,0,1">
    <MenuBar x:Name="MainMenu" Background="Transparent">
      <!-- Menu commands carry ids so a test can address them by identity. Without one, the only way
           to reach "打开视频…" from automation is to open the menu and match on its label, which is
           exactly the fragile step that made earlier file-entry checks unrepeatable. -->
      <MenuBarItem Title="文件" AutomationProperties.AutomationId="menu.file">
        <MenuFlyoutItem Text="打开视频…" Click="OnOpenVideoClick"
                        AutomationProperties.AutomationId="menu.openvideo">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="加入播放队列…" Click="OnAddToQueueClick"
                        AutomationProperties.AutomationId="menu.addtoqueue">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="打开文件夹…" Click="OnOpenFolderClick"
                        AutomationProperties.AutomationId="menu.openfolder">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="退出" Click="OnExitClick" />
      </MenuBarItem>
      <MenuBarItem Title="播放">
        <MenuFlyoutItem Text="播放 / 暂停" Click="OnPlayPauseMenuClick" />
        <MenuFlyoutItem Text="全屏切换" Click="OnFullscreenMenuClick" />
      </MenuBarItem>
      <MenuBarItem Title="帮助">
        <MenuFlyoutItem Text="关于 MediaHub" Click="OnAboutClick" />
      </MenuBarItem>
    </MenuBar>
    </Border>

    <!-- Shell layer: navigation chrome for browsing surfaces. -->
    <NavigationView
        Grid.Row="1"
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="True"
        PaneDisplayMode="Auto"
        CompactModeThresholdWidth="760"
        ExpandedModeThresholdWidth="1024"
        OpenPaneLength="236"
        Background="Transparent"
        SelectionChanged="OnNavSelectionChanged">
      <NavigationView.PaneHeader>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,14">
          <Border Width="28" Height="28" CornerRadius="10"
                  Background="{StaticResource MediaHubAccentSoftBrush}"
                  BorderBrush="{StaticResource MediaHubAccentBrush}" BorderThickness="1">
            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource MediaHubAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MediaHub" VerticalAlignment="Center"
                     FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource MediaHubTextPrimaryBrush}" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="首页" Tag="home">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="媒体库" Tag="libraries">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="搜索" Tag="search">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="继续观看" Tag="continue">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="我的收藏" Tag="favorites">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="播放列表" Tag="playlists">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="媒体源" Tag="sources">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="设置" Tag="settings">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ShellFrame" />
    </NavigationView>

    <!-- Player layer: a dedicated full-window surface. It is a sibling rather than a child of the
         NavigationView so the video rectangle can use the entire window in fullscreen. -->
    <Grid x:Name="PlayerLayer" Grid.RowSpan="2" Visibility="Collapsed">
      <Frame x:Name="PlayerFrame" />
    </Grid>
  </Grid>
</Window>
