<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.LocalLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="10">
      <TextBlock Text="本地媒体" Style="{StaticResource MediaHubSectionHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddFolderButton" Click="OnAddFolderClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
            <TextBlock Text="添加文件夹" />
          </StackPanel>
        </Button>
        <Button x:Name="RescanButton" Click="OnRescanClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="重新扫描" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenFileButton" Click="OnOpenFileClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
            <TextBlock Text="打开文件…" />
          </StackPanel>
        </Button>
        <ProgressRing x:Name="ScanRing" IsActive="False" Width="20" Height="20" />
      </StackPanel>

      <ItemsControl x:Name="FolderList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
              <FontIcon Glyph="&#xE8B7;" FontSize="12" />
              <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <InfoBar x:Name="EmptyHint" Grid.Row="1" Severity="Informational" IsOpen="False"
             Title="尚未添加媒体文件夹"
             Message="点击“添加文件夹”选择包含视频的目录，或直接“打开文件…”播放单个视频。" />

    <GridView x:Name="MediaGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnMediaItemClick">
      <GridView.ItemTemplate>
        <DataTemplate>
          <Border Width="240" Margin="0,0,12,12" CornerRadius="8" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
              <FontIcon Glyph="&#xE714;" FontSize="26" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
              <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource MediaHubCaption}" />
              <TextBlock Text="{Binding Path}" Style="{StaticResource MediaHubCaption}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
