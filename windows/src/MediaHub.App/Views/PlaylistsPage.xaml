<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock Text="播放列表" Style="{StaticResource MediaHubSectionHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- Ids so acceptance runs can address the controls by identity instead of by localised text. -->
        <Button x:Name="CreateButton" Content="新建播放列表" Click="OnCreateClick"
                AutomationProperties.AutomationId="playlists.new"
                AutomationProperties.Name="新建播放列表" />
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
      </StackPanel>
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="PlaylistList" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnPlaylistClick"
                AutomationProperties.AutomationId="playlists.list"
                AutomationProperties.Name="播放列表">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <!-- Rows own the full width so the per-row actions line up at the right edge. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource MediaHubCaption}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Plays the first entry only: a playlist is not a queue, so starting one never copies
                     the remaining entries into the temporary queue. -->
                <Button Content="播放" Click="OnPlayPlaylistClick" Tag="{Binding}"
                        AutomationProperties.AutomationId="playlist.play"
                        AutomationProperties.Name="{Binding PlayLabel}"
                        ToolTipService.ToolTip="从第一项开始播放" />
                <Button Content="重命名" Click="OnRenameClick" Tag="{Binding}"
                        AutomationProperties.AutomationId="playlist.rename"
                        AutomationProperties.Name="{Binding RenameLabel}" />
                <Button Content="删除" Click="OnDeleteClick" Tag="{Binding}"
                        AutomationProperties.AutomationId="playlist.delete"
                        AutomationProperties.Name="{Binding DeleteLabel}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  Visibility="Collapsed" AutomationProperties.Name="没有播放列表">
        <FontIcon Glyph="&#xE8FD;" FontSize="34" Opacity="0.4" />
        <TextBlock Text="还没有播放列表。" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="playlists.empty" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
