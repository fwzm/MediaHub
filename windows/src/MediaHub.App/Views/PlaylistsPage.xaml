<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,28,36,24" RowSpacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="播放列表" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Text="播放列表按条目播放，不会把整张列表复制进临时队列。"
                   Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
        <!-- Ids so acceptance runs can address the controls by identity instead of by localised text. -->
        <Button x:Name="CreateButton" Style="{StaticResource MediaHubPrimaryButton}" Click="OnCreateClick"
                AutomationProperties.AutomationId="playlists.new"
                AutomationProperties.Name="新建播放列表">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="13" />
            <TextBlock Text="新建播放列表" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="PlaylistList" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnPlaylistClick"
                AutomationProperties.AutomationId="playlists.list"
                AutomationProperties.Name="播放列表">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource MediaHubListViewItem}">
            <!-- Rows own the full width so the per-row actions line up at the right edge. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,2" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource MediaHubCaption}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Plays the first entry only: a playlist is not a queue, so starting one never copies
                     the remaining entries into the temporary queue. -->
                <Button Content="播放" Click="OnPlayPlaylistClick" Tag="{Binding}"
                        Style="{StaticResource MediaHubGhostButton}"
                        AutomationProperties.AutomationId="playlist.play"
                        AutomationProperties.Name="{Binding PlayLabel}"
                        ToolTipService.ToolTip="从第一项开始播放" />
                <Button Content="重命名" Click="OnRenameClick" Tag="{Binding}"
                        Style="{StaticResource MediaHubGhostButton}"
                        AutomationProperties.AutomationId="playlist.rename"
                        AutomationProperties.Name="{Binding RenameLabel}" />
                <Button Content="删除" Click="OnDeleteClick" Tag="{Binding}"
                        Style="{StaticResource MediaHubGhostButton}"
                        AutomationProperties.AutomationId="playlist.delete"
                        AutomationProperties.Name="{Binding DeleteLabel}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  Visibility="Collapsed" AutomationProperties.Name="没有播放列表" MaxWidth="460">
        <Border Style="{StaticResource MediaHubStateIcon}">
          <FontIcon Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE8FD;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Style="{StaticResource MediaHubStateTitle}" Text="还没有播放列表" />
          <TextBlock Style="{StaticResource MediaHubStateDescription}"
                     AutomationProperties.AutomationId="playlists.empty"
                     Text="在媒体详情页把条目加入列表，或先新建一个空列表。" />
        </StackPanel>
        <Button Content="新建播放列表" HorizontalAlignment="Center" Click="OnCreateClick"
                Style="{StaticResource MediaHubPrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
