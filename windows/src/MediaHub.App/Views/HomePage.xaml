<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="继续观看" Style="{StaticResource MediaHubSectionHeader}" />
      <TextBlock x:Name="ContinueEmptyText" Style="{StaticResource MediaHubCaption}"
                 Text="还没有播放记录。打开一个本地视频后，进度会自动记录在这里。" />
    </StackPanel>

    <GridView x:Name="ContinueGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnContinueItemClick">
      <GridView.ItemTemplate>
        <DataTemplate>
          <Border Width="220" Margin="0,0,12,12" CornerRadius="8" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
              <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1" />
              <TextBlock Style="{StaticResource MediaHubCaption}">
                <Run Text="{Binding PositionDisplay}" />
                <Run Text=" / " />
                <Run Text="{Binding DurationDisplay}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
