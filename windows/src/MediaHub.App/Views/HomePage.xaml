<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <ScrollViewer x:Name="HomeScroll" Padding="36,28,36,28">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HomeScroll.Padding" Value="20,18,20,20" />
            <Setter Target="DisplayTitle.FontSize" Value="26" />
            <!-- Four entry cards do not fit one row in a narrow window; stacking keeps every label
                 readable instead of squeezing the last card off the right edge. -->
            <Setter Target="QuickActions.Orientation" Value="Vertical" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <StackPanel Spacing="26" MaxWidth="1600" HorizontalAlignment="Left">

      <!-- Header: product name, what is connected, and the four entry points. -->
      <StackPanel Spacing="6">
        <TextBlock x:Name="DisplayTitle" Text="MediaHub" Style="{StaticResource MediaHubDisplay}" />
        <TextBlock x:Name="SourceSummaryText" Style="{StaticResource MediaHubCaption}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel x:Name="QuickActions" Orientation="Horizontal" Spacing="12">
        <Button x:Name="LibrariesButton" Click="OnLibrariesClick" Style="{StaticResource MediaHubCardButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource MediaHubAccentBrush}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="媒体库" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="浏览全部片库" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="SearchButton" Click="OnSearchClick" Style="{StaticResource MediaHubCardButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource MediaHubAccentBrush}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="搜索" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="跨媒体源查找" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="SourcesButton" Click="OnSourcesClick" Style="{StaticResource MediaHubCardButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource MediaHubAccentBrush}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="媒体源" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="管理与检测连接" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="LocalButton" Click="OnLocalClick" Style="{StaticResource MediaHubCardButton}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource MediaHubAccentBrush}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="本地媒体" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="本机文件夹与文件" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="本地最近播放" Style="{StaticResource MediaHubSectionHeader}" />
        <!-- The empty hint is a quiet card rather than a stray caption, so the section keeps its shape
             before there is anything to show in it. -->
        <Border x:Name="ContinueEmptyCard" Style="{StaticResource MediaHubCard}" Padding="16,14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center"
                      Foreground="{StaticResource MediaHubTextSecondaryBrush}" />
            <TextBlock x:Name="ContinueEmptyText" AutomationProperties.AutomationId="home.continue.empty"
                       Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="还没有本地播放记录。打开一个本地视频后，进度会自动记录在这里。" />
          </StackPanel>
        </Border>
      </StackPanel>

      <GridView x:Name="ContinueGrid" AutomationProperties.AutomationId="home.continue.grid" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnContinueItemClick" MaxHeight="420"
                ItemContainerStyle="{StaticResource MediaHubGridViewItem}">
        <GridView.ItemTemplate>
          <DataTemplate>
            <Border Width="248" Margin="0,0,14,14" Padding="16" Style="{StaticResource MediaHubCard}">
              <StackPanel Spacing="10">
                <!-- A thin accent rule stands in for artwork here: these rows are local files and
                     have no poster, so the rule gives the card an anchor without inventing artwork. -->
                <Border Height="3" Width="28" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{StaticResource MediaHubAccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="2" />
                <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1" Height="3" />
                <TextBlock Style="{StaticResource MediaHubCaption}">
                  <Run Text="{Binding PositionDisplay}" />
                  <Run Text=" / " />
                  <Run Text="{Binding DurationDisplay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource MediaHubCaption}" Text="{Binding SourceLabel}"
                           Foreground="{StaticResource MediaHubTextTertiaryBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
    </StackPanel>
  </ScrollViewer>
</Page>
