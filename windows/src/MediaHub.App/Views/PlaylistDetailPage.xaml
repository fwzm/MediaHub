<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <Button x:Name="BackButton" Click="OnBackClick" Background="Transparent"
              AutomationProperties.Name="返回播放列表" AutomationProperties.AutomationId="playlist.back">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock x:Name="TitleText" Text="播放列表" Margin="0" VerticalAlignment="Center"
                 Style="{StaticResource MediaHubSectionHeader}"
                 AutomationProperties.AutomationId="playlist.title" />
      <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="ItemList" SelectionMode="None"
                AutomationProperties.AutomationId="playlist.items"
                AutomationProperties.Name="播放列表条目">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Title}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MediaHubCaption}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- One request for one item: the rest of the playlist is not copied into the queue. -->
                <Button Content="播放" Click="OnPlayItemClick" Tag="{Binding}"
                        AutomationProperties.AutomationId="playlist.item.play"
                        AutomationProperties.Name="{Binding PlayLabel}" />
                <Button Content="移除" Click="OnRemoveItemClick" Tag="{Binding}"
                        AutomationProperties.AutomationId="playlist.item.remove"
                        AutomationProperties.Name="{Binding RemoveLabel}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  Visibility="Collapsed" AutomationProperties.Name="播放列表为空">
        <FontIcon Glyph="&#xE8FD;" FontSize="34" Opacity="0.4" />
        <TextBlock Text="这个播放列表还是空的。" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="playlist.items.empty" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
