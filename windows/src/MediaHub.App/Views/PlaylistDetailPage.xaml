<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,24,36,24" RowSpacing="14">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource MediaHubIconButton}"
              AutomationProperties.Name="返回播放列表" AutomationProperties.AutomationId="playlist.back">
        <FontIcon Glyph="&#xE72B;" FontSize="15" />
      </Button>
      <TextBlock x:Name="TitleText" Text="播放列表" Margin="4,0,0,0" VerticalAlignment="Center"
                 Style="{StaticResource MediaHubPageTitle}"
                 AutomationProperties.AutomationId="playlist.title" />
      <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="ItemList" SelectionMode="None"
                AutomationProperties.AutomationId="playlist.items"
                AutomationProperties.Name="播放列表条目"
                ItemContainerStyle="{StaticResource MediaHubListViewItem}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" ColumnSpacing="12" AutomationProperties.Name="{Binding Title}">
              <Grid.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="播放" Tag="{Binding}" Click="OnPlayMenuClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="复制标题" Tag="{Binding}" Click="OnCopyTitleClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Grid.ContextFlyout>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MediaHubCaption}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- One request for one item: the rest of the playlist is not copied into the queue. -->
                <Button Content="播放" Click="OnPlayItemClick" Tag="{Binding}"
                        Style="{StaticResource MediaHubGhostButton}"
                        AutomationProperties.AutomationId="playlist.item.play"
                        AutomationProperties.Name="{Binding PlayLabel}" />
                <Button Content="移除" Click="OnRemoveItemClick" Tag="{Binding}"
                        Style="{StaticResource MediaHubGhostButton}"
                        AutomationProperties.AutomationId="playlist.item.remove"
                        AutomationProperties.Name="{Binding RemoveLabel}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  Visibility="Collapsed" AutomationProperties.Name="播放列表为空" MaxWidth="440">
        <Border Style="{StaticResource MediaHubStateIcon}">
          <FontIcon Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE8FD;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Style="{StaticResource MediaHubStateTitle}" Text="这个播放列表还是空的" />
          <TextBlock Style="{StaticResource MediaHubStateDescription}"
                     AutomationProperties.AutomationId="playlist.items.empty"
                     Text="在媒体详情页把条目加入该列表后，它们会按顺序显示在这里。" />
        </StackPanel>
        <Button Content="返回播放列表" HorizontalAlignment="Center" Click="OnBackClick"
                Style="{StaticResource MediaHubGhostButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
