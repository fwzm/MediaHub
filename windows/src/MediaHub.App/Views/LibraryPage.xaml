<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="BackButton" Click="OnBackClick" Background="Transparent">
          <FontIcon Glyph="&#xE72B;" />
        </Button>
        <TextBlock x:Name="TitleText" Style="{StaticResource MediaHubSectionHeader}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="CountText" Style="{StaticResource MediaHubCaption}" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <GridView x:Name="ItemGrid" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnItemClick">
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="{Binding TileWidth}" Margin="0,0,14,16" Spacing="6">
              <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" CornerRadius="6"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <!-- Placeholder glyph stays visible until artwork arrives, so a slow or failed
                       poster never leaves an empty hole in the grid. -->
                  <FontIcon Glyph="&#xE714;" FontSize="28" Opacity="0.35"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                         MaxLines="2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MediaHubCaption}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" Visibility="Collapsed">
        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="36" Height="36" />
        <TextBlock x:Name="EmptyText" Text="正在加载…" HorizontalAlignment="Center" />
      </StackPanel>

      <Button x:Name="LoadMoreButton" Content="加载更多" HorizontalAlignment="Center"
              VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed"
              Click="OnLoadMoreClick" />
    </Grid>
  </Grid>
</Page>
