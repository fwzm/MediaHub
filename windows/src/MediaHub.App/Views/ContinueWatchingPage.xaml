<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.ContinueWatchingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,28,36,24" RowSpacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="继续观看" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Text="按上次播放位置继续。缩略图来自媒体源。"
                   Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
        <Button x:Name="ReloadButton" AutomationProperties.AutomationId="continue.reload"
                Style="{StaticResource MediaHubGhostButton}" Click="OnReloadClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="刷新" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <GridView x:Name="ItemGrid" AutomationProperties.AutomationId="continue.grid" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnItemClick" ContainerContentChanging="OnContainerContentChanging"
                ItemContainerStyle="{StaticResource MediaHubGridViewItem}">
        <GridView.ItemContainerTransitions>
          <TransitionCollection>
            <AddDeleteThemeTransition />
            <RepositionThemeTransition />
          </TransitionCollection>
        </GridView.ItemContainerTransitions>
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="300" Margin="0,0,16,18" Spacing="7">
              <StackPanel.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="继续播放" Tag="{Binding}" Click="OnPlayMenuClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="打开详情" Tag="{Binding}" Click="OnOpenMenuClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="复制标题" Tag="{Binding}" Click="OnCopyTitleClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </StackPanel.ContextFlyout>
              <Border Width="300" Height="169" Style="{StaticResource MediaHubPosterFrame}">
                <Grid>
                  <FontIcon Glyph="&#xE714;" FontSize="26" Opacity="0.3"
                            Foreground="{StaticResource MediaHubTextSecondaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding Card.Poster}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="7" Padding="7,2"
                          CornerRadius="999" Background="#B30A0C10">
                    <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="#E6FFFFFF" />
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <ProgressBar Value="{Binding Fraction}" Minimum="0" Maximum="1" Height="3" />
              <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ItemsControl x:Name="SkeletonPanel" Visibility="Collapsed" IsHitTestVisible="False"
                    ItemTemplate="{StaticResource MediaHubLandscapeSkeleton}"
                    ItemsPanel="{StaticResource MediaHubSkeletonLandscapePanel}" />

      <StackPanel x:Name="EmptyPanel" AutomationProperties.AutomationId="continue.empty"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  Visibility="Collapsed" MaxWidth="460">
        <Border x:Name="StateIcon" Style="{StaticResource MediaHubStateIcon}">
          <FontIcon x:Name="StateGlyph" Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE81C;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock x:Name="StateTitle" Style="{StaticResource MediaHubStateTitle}" Text="还没有可继续观看的内容" />
          <TextBlock x:Name="EmptyText" Style="{StaticResource MediaHubStateDescription}"
                     Text="在任意媒体源上开始播放后，进度会出现在这里。" />
        </StackPanel>
        <Button Content="刷新" HorizontalAlignment="Center" Click="OnReloadClick"
                Style="{StaticResource MediaHubGhostButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
