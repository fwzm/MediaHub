<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.ContinueWatchingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock Text="继续观看" Style="{StaticResource MediaHubSectionHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ReloadButton" AutomationProperties.AutomationId="continue.reload" Content="刷新" Click="OnReloadClick" />
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
      </StackPanel>
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <GridView x:Name="ItemGrid" AutomationProperties.AutomationId="continue.grid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="300" Margin="0,0,14,16" Spacing="6">
              <Border Width="300" Height="169" CornerRadius="6"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <FontIcon Glyph="&#xE714;" FontSize="26" Opacity="0.35"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding Card.Poster}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6" Padding="6,2"
                          CornerRadius="4" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <TextBlock Text="{Binding SourceLabel}" FontSize="10" />
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <ProgressBar Value="{Binding Fraction}" Minimum="0" Maximum="1" />
              <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <StackPanel x:Name="EmptyPanel" AutomationProperties.AutomationId="continue.empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  Visibility="Collapsed">
        <FontIcon Glyph="&#xE81C;" FontSize="34" Opacity="0.4" />
        <TextBlock x:Name="EmptyText" Text="还没有可继续观看的内容。" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
