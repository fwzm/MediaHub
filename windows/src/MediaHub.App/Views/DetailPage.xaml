<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="20,14,20,6">
      <Button x:Name="BackButton" Click="OnBackClick" Background="Transparent">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock x:Name="HeaderText" VerticalAlignment="Center" Style="{StaticResource MediaHubCaption}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="28,0,28,28">
      <StackPanel Spacing="18" MaxWidth="1080" HorizontalAlignment="Left">

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="220" Height="330" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
              <FontIcon Glyph="&#xE714;" FontSize="34" Opacity="0.35"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="PosterImage" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
            <TextBlock x:Name="SourceText" Style="{StaticResource MediaHubCaption}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="PlayButton" Click="OnPlayClick" Style="{StaticResource AccentButtonStyle}"
                      AutomationProperties.Name="播放" AutomationProperties.AutomationId="detail.play">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE768;" FontSize="14" />
                  <TextBlock x:Name="PlayButtonText" Text="播放" />
                </StackPanel>
              </Button>
              <Button x:Name="ResumeButton" Click="OnResumeClick" Visibility="Collapsed"
                      AutomationProperties.Name="继续观看" AutomationProperties.AutomationId="detail.resume">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE81C;" FontSize="14" />
                  <TextBlock x:Name="ResumeButtonText" Text="继续观看" />
                </StackPanel>
              </Button>
              <Button x:Name="FavoriteButton" Click="OnFavoriteClick" Visibility="Collapsed"
                      AutomationProperties.Name="收藏" AutomationProperties.AutomationId="detail.favorite">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="14" />
                  <TextBlock x:Name="FavoriteButtonText" Text="收藏" />
                </StackPanel>
              </Button>
              <!-- Entries are filled in when the flyout opens, because playlists are created, renamed
                   and deleted while this page is alive. -->
              <Button x:Name="AddToPlaylistButton" Visibility="Collapsed"
                      AutomationProperties.Name="加入播放列表" AutomationProperties.AutomationId="detail.addtoplaylist">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE710;" FontSize="14" />
                  <TextBlock Text="加入播放列表" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout x:Name="AddToPlaylistMenu" Opening="OnAddToPlaylistOpening" />
                </Button.Flyout>
              </Button>
              <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <TextBlock x:Name="OverviewText" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- Episodes: only populated for series, and hidden rather than shown empty. -->
        <StackPanel x:Name="EpisodesSection" Spacing="10" Visibility="Collapsed">
          <TextBlock Text="剧集" FontSize="18" FontWeight="SemiBold" />
          <ComboBox x:Name="SeasonCombo" MinWidth="260" SelectionChanged="OnSeasonChanged" />
          <ListView x:Name="EpisodeList" SelectionMode="None" IsItemClickEnabled="True"
                    ItemClick="OnEpisodeClick" MaxHeight="420">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="6" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding EpisodeLabel}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MediaHubCaption}" />
                  </StackPanel>
                  <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="13" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <StackPanel x:Name="VersionsSection" Spacing="8" Visibility="Collapsed">
          <TextBlock Text="播放源" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="以下信息来自服务器返回的媒体源描述；未上报的字段显示为“未知”，不做推测。" />
          <ItemsControl x:Name="StreamList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MediaHubCaption}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
