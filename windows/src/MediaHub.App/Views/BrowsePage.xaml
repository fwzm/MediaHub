<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="UpButton" Click="OnUpClick" Background="Transparent"
                AutomationProperties.Name="返回上级" AutomationProperties.AutomationId="browse.up">
          <FontIcon Glyph="&#xE72B;" />
        </Button>
        <!-- A stable way back to the shell. Walking up with the arrow only reaches the source root,
             so without this the only exit from a root listing is the navigation pane. -->
        <Button x:Name="RootsButton" Click="OnRootsClick" Background="Transparent"
                AutomationProperties.Name="返回媒体库" AutomationProperties.AutomationId="browse.roots">
          <FontIcon Glyph="&#xE8B7;" />
        </Button>
        <TextBlock x:Name="TitleText" Style="{StaticResource MediaHubSectionHeader}" VerticalAlignment="Center" />
      </StackPanel>
      <!-- Breadcrumb. Shows where in the tree the user is, which matters because a WebDAV root can be
           any sub-path of the host and "which folder am I in" is otherwise invisible. -->
      <TextBlock x:Name="BreadcrumbText" Style="{StaticResource MediaHubCaption}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="SourceText" Style="{StaticResource MediaHubCaption}" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="ItemList" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                AutomationProperties.AutomationId="browse.list">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="6" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.AutomationId="{Binding AutomationId}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MediaHubCaption}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="{Binding TrailingGlyph}" FontSize="12"
                        VerticalAlignment="Center" Opacity="0.6" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="10" Visibility="Collapsed">
        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="36" Height="36" />
        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        <!-- Only a failed read shows this. Without it the page's only exit from a server error was to
             navigate away and come back, which is not something a user should have to discover. -->
        <Button x:Name="RetryButton" Content="重试" Click="OnRetryClick" Visibility="Collapsed"
                HorizontalAlignment="Center" AutomationProperties.AutomationId="browse.retry" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
