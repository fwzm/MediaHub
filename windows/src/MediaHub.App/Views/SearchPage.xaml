<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,28,36,24" RowSpacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
            <Setter Target="QueryBox.Width" Value="NaN" />
            <Setter Target="QueryBox.HorizontalAlignment" Value="Stretch" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="搜索" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Text="每个已连接的媒体源独立返回结果，卡片左上角标注来源。"
                   Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="QueryBox" Grid.Column="0" Width="460" MinWidth="220" MinHeight="38"
                 HorizontalAlignment="Left" CornerRadius="10"
                 PlaceholderText="搜索所有已连接的媒体源…" KeyDown="OnQueryKeyDown"
                 Background="{StaticResource MediaHubGlassRaisedBrush}"
                 BorderBrush="{StaticResource MediaHubGlassEdgeBrush}" />
        <Button x:Name="SearchButton" Grid.Column="1" Click="OnSearchClick"
                Style="{StaticResource MediaHubPrimaryButton}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE721;" FontSize="13" />
            <TextBlock Text="搜索" />
          </StackPanel>
        </Button>
        <ProgressRing x:Name="BusyRing" Grid.Column="2" IsActive="False" Width="20" Height="20"
                      VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="ResultSummary" Style="{StaticResource MediaHubCaption}" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <GridView x:Name="ResultGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnResultClick"
                ItemContainerStyle="{StaticResource MediaHubGridViewItem}">
        <GridView.ItemContainerTransitions>
          <TransitionCollection>
            <AddDeleteThemeTransition />
            <RepositionThemeTransition />
          </TransitionCollection>
        </GridView.ItemContainerTransitions>
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="{Binding Card.TileWidth}" Margin="0,0,16,18" Spacing="7">
              <StackPanel.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="打开详情" Tag="{Binding}" Click="OnOpenMenuClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="复制标题" Tag="{Binding}" Click="OnCopyTitleClick">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </StackPanel.ContextFlyout>
              <Border Width="{Binding Card.TileWidth}" Height="{Binding Card.TileHeight}"
                      Style="{StaticResource MediaHubPosterFrame}">
                <Grid>
                  <FontIcon Glyph="&#xE714;" FontSize="26" Opacity="0.3"
                            Foreground="{StaticResource MediaHubTextSecondaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding Card.Poster}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="7"
                          Padding="7,2" CornerRadius="999" Background="#B30A0C10">
                    <TextBlock Text="{Binding Card.SourceLabel}" FontSize="10"
                               Foreground="#E6FFFFFF" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Card.Badges}" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="6" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#CC0B0D12" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="4" Padding="5,1">
                          <TextBlock Text="{Binding}" FontSize="10" Foreground="#F2FFFFFF" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Card.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                         MaxLines="2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Card.Subtitle}" Style="{StaticResource MediaHubCaption}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ItemsControl x:Name="SkeletonPanel" Visibility="Collapsed" IsHitTestVisible="False"
                    ItemTemplate="{StaticResource MediaHubPosterSkeleton}"
                    ItemsPanel="{StaticResource MediaHubSkeletonWrapPanel}" />

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  MaxWidth="460">
        <Border x:Name="StateIcon" Style="{StaticResource MediaHubStateIcon}">
          <FontIcon x:Name="StateGlyph" Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE721;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock x:Name="StateTitle" Style="{StaticResource MediaHubStateTitle}" Text="搜索媒体库" />
          <TextBlock x:Name="EmptyText" Style="{StaticResource MediaHubStateDescription}"
                     Text="输入关键词开始搜索；每个已连接的媒体源会独立返回结果。" />
        </StackPanel>
        <Button x:Name="RetryButton" Content="重试" Visibility="Collapsed" HorizontalAlignment="Center"
                Click="OnRetryClick" Style="{StaticResource MediaHubGhostButton}"
                AutomationProperties.AutomationId="search.retry" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
