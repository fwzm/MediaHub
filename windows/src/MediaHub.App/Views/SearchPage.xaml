<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="10">
      <TextBlock Text="搜索" Style="{StaticResource MediaHubSectionHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="QueryBox" Width="420" PlaceholderText="搜索所有已连接的媒体源…" KeyDown="OnQueryKeyDown" />
        <Button x:Name="SearchButton" Content="搜索" Click="OnSearchClick" />
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
      </StackPanel>
      <TextBlock x:Name="ResultSummary" Style="{StaticResource MediaHubCaption}" />
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <GridView x:Name="ResultGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnResultClick">
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="{Binding Card.TileWidth}" Margin="0,0,14,16" Spacing="6">
              <Border Width="{Binding Card.TileWidth}" Height="{Binding Card.TileHeight}" CornerRadius="6"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <FontIcon Glyph="&#xE714;" FontSize="26" Opacity="0.35"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding Card.Poster}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                          Padding="6,2" CornerRadius="4"
                          Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <TextBlock Text="{Binding Card.SourceLabel}" FontSize="10" />
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="{Binding Card.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                         MaxLines="2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Card.Subtitle}" Style="{StaticResource MediaHubCaption}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <FontIcon Glyph="&#xE721;" FontSize="34" Opacity="0.4" />
        <TextBlock x:Name="EmptyText" Text="输入关键词开始搜索。每个已连接的媒体源会独立返回结果。"
                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
