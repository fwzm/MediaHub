<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <ScrollViewer x:Name="SettingsScroll" Padding="36,28,36,36">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SettingsScroll.Padding" Value="20,18,20,28" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <!-- A single column capped at a readable width. Without the column, a left-aligned stack
         collapses to the widest child and the settings column shrinks to about 220 px. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="860" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="18">

      <StackPanel Spacing="4" Margin="0,0,0,4">
        <TextBlock Text="设置" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Text="设置保存在本机；媒体源账号与会话令牌单独存放在加密凭据库中。"
                   Style="{StaticResource MediaHubCaption}" />
      </StackPanel>

      <Expander IsExpanded="True" Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="播放" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="18" Padding="0,6,0,8">
          <StackPanel Spacing="6">
            <Grid>
              <TextBlock Text="默认音量" Style="{StaticResource MediaHubFieldLabel}" />
              <TextBlock Text="{Binding Value, ElementName=VolumeSlider}" HorizontalAlignment="Right"
                         Style="{StaticResource MediaHubMono}"
                         Foreground="{StaticResource MediaHubTextPrimaryBrush}" />
            </Grid>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" StepFrequency="1" ValueChanged="OnVolumeChanged" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="默认倍速" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="SpeedCombo" SelectionChanged="OnSpeedChanged" MinWidth="140" CornerRadius="10" />
          </StackPanel>
          <ToggleSwitch x:Name="ResumeSwitch" Header="记忆播放位置" OnContent="开" OffContent="关" Toggled="OnResumeToggled" />
          <ToggleSwitch x:Name="AutoPlayNextSwitch" Header="自动连播下一集" OnContent="开" OffContent="关" Toggled="OnAutoPlayNextToggled" />
          <StackPanel Spacing="6">
            <TextBlock Text="画质优先级（同一条目有多个版本时）" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="QualityPreferenceCombo" MinWidth="220" CornerRadius="10"
                      SelectionChanged="OnQualityPreferenceChanged"
                      AutomationProperties.AutomationId="settings.qualitypreference" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="只调整可直接播放版本之间的选择顺序：自动沿用服务器顺序（直连优先），最高/最低按分辨率与码率挑选。不会为了画质强制转码。" />
          </StackPanel>
          <StackPanel Spacing="6">
            <ToggleSwitch x:Name="DiskCacheSwitch" Header="启用播放器磁盘缓存" OnContent="开" OffContent="关"
                          Toggled="OnDiskCacheToggled" AutomationProperties.AutomationId="settings.diskcache" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="把播放器的预读数据写到本机磁盘，改善切换与短暂网络抖动时的表现。目录：MediaHub\cache\mpv。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="DiskCacheCapacityCombo" MinWidth="140" CornerRadius="10"
                        SelectionChanged="OnDiskCacheCapacityChanged"
                        AutomationProperties.AutomationId="settings.diskcachecapacity" />
              <Button Content="立即清理" Click="OnClearDiskCacheClick"
                      AutomationProperties.AutomationId="settings.cleardiskcache" />
            </StackPanel>
            <TextBlock x:Name="DiskCacheUsageText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="settings.diskcacheusage" />
            <ToggleSwitch x:Name="ClearDiskCacheSwitch" Header="播放结束时清理缓存" OnContent="开" OffContent="关"
                          Toggled="OnClearDiskCacheToggled" AutomationProperties.AutomationId="settings.clearcacheonend" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="音频输出设备" Style="{StaticResource MediaHubFieldLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="AudioDeviceCombo" MinWidth="280" CornerRadius="10" DisplayMemberPath="Description"
                        SelectionChanged="OnAudioDeviceChanged"
                        AutomationProperties.AutomationId="settings.audiodevice" />
              <Button Content="刷新设备" Click="OnRefreshAudioDevicesClick" />
            </StackPanel>
            <TextBlock x:Name="AudioDeviceStatus" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="settings.audiodevicestatus" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="字幕" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="18" Padding="0,6,0,8">
          <ToggleSwitch x:Name="SubtitleSwitch" Header="默认显示字幕" OnContent="开" OffContent="关" Toggled="OnSubtitleToggled" />
          <StackPanel Spacing="6">
            <Grid>
              <TextBlock Text="字号" Style="{StaticResource MediaHubFieldLabel}" />
              <TextBlock Text="{Binding Value, ElementName=SubtitleSizeSlider}" HorizontalAlignment="Right"
                         Style="{StaticResource MediaHubMono}"
                         Foreground="{StaticResource MediaHubTextPrimaryBrush}" />
            </Grid>
            <Slider x:Name="SubtitleSizeSlider" Minimum="20" Maximum="120" StepFrequency="1" ValueChanged="OnSubtitleSizeChanged" />
          </StackPanel>
          <ToggleSwitch x:Name="SubtitleBoldSwitch" Header="加粗" OnContent="开" OffContent="关" Toggled="OnSubtitleBoldToggled"
                        AutomationProperties.AutomationId="settings.subtitlebold" />
          <StackPanel Spacing="6">
            <TextBlock Text="字体" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="SubtitleFontCombo" IsEditable="True" MinWidth="240" CornerRadius="10"
                      SelectionChanged="OnSubtitleFontChanged" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="颜色" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="SubtitleColorCombo" SelectionChanged="OnSubtitleColorChanged" MinWidth="180" CornerRadius="10" />
          </StackPanel>
          <StackPanel Spacing="6">
            <Grid>
              <TextBlock Text="描边粗细" Style="{StaticResource MediaHubFieldLabel}" />
              <TextBlock Text="{Binding Value, ElementName=SubtitleBorderSlider}" HorizontalAlignment="Right"
                         Style="{StaticResource MediaHubMono}"
                         Foreground="{StaticResource MediaHubTextPrimaryBrush}" />
            </Grid>
            <Slider x:Name="SubtitleBorderSlider" Minimum="0" Maximum="10" StepFrequency="0.5" ValueChanged="OnSubtitleBorderChanged" />
          </StackPanel>
          <StackPanel Spacing="6">
            <Grid>
              <TextBlock Text="垂直位置" Style="{StaticResource MediaHubFieldLabel}" />
              <TextBlock Text="{Binding Value, ElementName=SubtitlePosSlider}" HorizontalAlignment="Right"
                         Style="{StaticResource MediaHubMono}"
                         Foreground="{StaticResource MediaHubTextPrimaryBrush}" />
            </Grid>
            <Slider x:Name="SubtitlePosSlider" Minimum="0" Maximum="150" StepFrequency="1" ValueChanged="OnSubtitlePosChanged" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="ASS 样式覆盖" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="AssOverrideCombo" SelectionChanged="OnAssOverrideChanged" MinWidth="200" CornerRadius="10" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="默认“强制”，内封 ASS/SSA 字幕也会使用上面的字号、颜色、描边与加粗；选“不覆盖”则保留字幕文件自带的样式。" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="界面" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="18" Padding="0,6,0,8">
          <ToggleSwitch x:Name="AutoHideSwitch" Header="播放时自动隐藏控制栏" OnContent="开" OffContent="关" Toggled="OnAutoHideToggled" />
          <ToggleSwitch x:Name="DetailInfoSwitch" Header="默认显示详细媒体信息（编码/色彩/解码器）" OnContent="开" OffContent="关" Toggled="OnDetailInfoToggled" />
          <StackPanel Spacing="4">
            <ToggleSwitch x:Name="ScreenshotSwitch" Header="允许在播放器中截图" OnContent="开" OffContent="关" Toggled="OnScreenshotToggled" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="开启后播放器顶栏出现截图按钮，用播放器自身的渲染结果保存 PNG（包含字幕），存到“图片\MediaHub 截图”。关闭时播放器不显示任何截图入口。" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="媒体徽章" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="12" Padding="0,6,0,8">
          <ToggleSwitch x:Name="MediaBadgesSwitch" Header="在资源卡片上显示徽章" OnContent="开" OffContent="关"
                        Toggled="OnMediaBadgesToggled" AutomationProperties.AutomationId="settings.mediabadges" />
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="徽章使用服务器报告的片源信息；未报告的信息不会显示，也不会写成猜测值。" />
          <StackPanel Spacing="2">
            <CheckBox x:Name="BadgeResolutionCheck" Content="分辨率" Tag="resolution" Checked="OnBadgeItemToggled" Unchecked="OnBadgeItemToggled" />
            <CheckBox x:Name="BadgeHdrCheck" Content="HDR / 杜比视界" Tag="hdr" Checked="OnBadgeItemToggled" Unchecked="OnBadgeItemToggled" />
            <CheckBox x:Name="BadgeVideoCheck" Content="视频编码" Tag="video" Checked="OnBadgeItemToggled" Unchecked="OnBadgeItemToggled" />
            <CheckBox x:Name="BadgeAudioCheck" Content="音频格式与声道" Tag="audio" Checked="OnBadgeItemToggled" Unchecked="OnBadgeItemToggled" />
            <CheckBox x:Name="BadgeContainerCheck" Content="封装格式" Tag="container" Checked="OnBadgeItemToggled" Unchecked="OnBadgeItemToggled" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="快捷键与操作" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="10" Padding="0,6,0,8">
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="以下是播放器接受的全部输入方式；播放中按 ? 或 F1 可以打开同一份说明。" />
          <ItemsControl x:Name="ShortcutList" AutomationProperties.AutomationId="settings.shortcuts">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Keys}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="播放引擎（高级）" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="18" Padding="0,6,0,8">
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="这些选项直接传递给播放引擎。修改后需要重新进入播放页生效。硬件解码失败时会自动回退到软件解码。" />
          <StackPanel Spacing="6">
            <TextBlock Text="硬件解码" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="HwDecCombo" SelectionChanged="OnHwDecChanged" MinWidth="220" CornerRadius="10" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="HDR 动态元数据处理" Style="{StaticResource MediaHubFieldLabel}" />
            <ComboBox x:Name="HdrDynamicMetadataCombo" SelectionChanged="OnHdrDynamicMetadataChanged"
                      MinWidth="220" CornerRadius="10" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="杜比视界（RPU）与 HDR10+ 的逐镜头元数据如何使用。默认跟随片源（最稳）；画面忽明忽暗时可只信片源元数据，或让引擎按画面实时计算峰值。修改后重新进入播放页生效。" />
          </StackPanel>
          <TextBlock x:Name="EngineInfoText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="系统集成" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="12" Padding="0,6,0,8">
          <TextBlock Text="文件关联" Style="{StaticResource MediaHubSubsectionHeader}" />
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="把 MediaHub 登记为视频文件的候选用“打开方式”程序。不会抢占系统默认播放器，也不会修改你的默认选择；如需将 MediaHub 设为默认，请在 Windows 设置中自行选择。" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="RegisterAssocButton" Content="启用文件关联" Click="OnRegisterAssociationClick"
                    Style="{StaticResource MediaHubGhostButton}" />
            <Button x:Name="UnregisterAssocButton" Content="移除文件关联" Click="OnUnregisterAssociationClick"
                    Style="{StaticResource MediaHubGhostButton}" />
            <ProgressRing x:Name="AssocRing" IsActive="False" Width="20" Height="20" />
          </StackPanel>
          <TextBlock x:Name="AssocStatusText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="软件更新" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="12" Padding="0,6,0,8">
          <StackPanel Spacing="6">
            <TextBlock Text="更新源" Style="{StaticResource MediaHubFieldLabel}" />
            <TextBox x:Name="UpdateSourceBox" CornerRadius="10" MinHeight="36"
                     PlaceholderText="D:\MediaHub-Update 或 https://example.com/mediahub/"
                     TextChanged="OnUpdateSourceChanged"
                     AutomationProperties.AutomationId="settings.updatesource" />
            <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                       Text="本地目录或 HTTP 静态目录，目录中需要 update.json 与它指向的 zip。更新先校验 SHA-256，再退出应用并由更新代理替换文件；失败会自动恢复上一版本。" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdateClick"
                    Style="{StaticResource MediaHubGhostButton}"
                    AutomationProperties.AutomationId="settings.updatecheck" />
            <Button x:Name="ApplyUpdateButton" Content="立即更新" Click="OnApplyUpdateClick" IsEnabled="False"
                    Style="{StaticResource MediaHubPrimaryButton}"
                    AutomationProperties.AutomationId="settings.updateapply" />
            <ProgressRing x:Name="UpdateRing" IsActive="False" Width="20" Height="20" />
          </StackPanel>
          <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="settings.updatestatus" />
          <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                     Text="更新包与应用本身都没有代码签名。从浏览器下载的 zip 可能带“来自 Internet”标记，首次运行仍会被 SmartScreen 提示；应用内更新只能校验完整性，无法消除该提示。" />
        </StackPanel>
      </Expander>

      <Expander Style="{StaticResource MediaHubExpander}">
        <Expander.Header>
          <TextBlock Text="诊断" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="12" Padding="0,6,0,8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="导出已脱敏日志" Click="OnExportLogClick" Style="{StaticResource MediaHubGhostButton}" />
            <Button Content="打开日志文件夹" Click="OnOpenLogFolderClick" Style="{StaticResource MediaHubGhostButton}" />
          </StackPanel>
          <TextBlock x:Name="DiagnosticsText" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
