<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.LibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,20,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock Text="媒体库" Style="{StaticResource MediaHubSectionHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- Automated ids so acceptance runs can address the reload button and the per-source
             failure banner by identity instead of by matching localised text. -->
        <Button x:Name="ReloadButton" Click="OnReloadClick" AutomationProperties.AutomationId="libraries.reload">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="刷新" />
          </StackPanel>
        </Button>
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
      </StackPanel>
    </StackPanel>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"
             AutomationProperties.AutomationId="libraries.status" />

    <GridView x:Name="LibraryGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnLibraryClick">
      <GridView.ItemTemplate>
        <DataTemplate>
          <!-- Named and id'd so a tile is addressable by identity rather than by position or by a
               display name that two sources can share. -->
          <Border Width="240" Height="120" Margin="0,0,12,12" CornerRadius="8" Padding="14"
                  AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.AutomationId="{Binding AutomationId}"
                  AutomationProperties.HelpText="{Binding KindLabel}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE8B7;" FontSize="20" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MediaHubCaption}" />
              <TextBlock Text="{Binding KindLabel}" Style="{StaticResource MediaHubCaption}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
