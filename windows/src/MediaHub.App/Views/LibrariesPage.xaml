<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.LibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,28,36,28" RowSpacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="媒体库" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Text="每个已连接的媒体源会按分类列出片库。"
                   Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
        <!-- Automated id so acceptance runs can address the reload button by identity rather than
             by matching localised text. -->
        <Button x:Name="ReloadButton" Click="OnReloadClick" Style="{StaticResource MediaHubGhostButton}"
                AutomationProperties.AutomationId="libraries.reload">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="刷新" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"
             AutomationProperties.AutomationId="libraries.status" />

    <Grid Grid.Row="2">
      <GridView x:Name="LibraryGrid" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnLibraryClick" ItemContainerStyle="{StaticResource MediaHubGridViewItem}">
        <GridView.ItemContainerTransitions>
          <TransitionCollection>
            <AddDeleteThemeTransition />
            <RepositionThemeTransition />
          </TransitionCollection>
        </GridView.ItemContainerTransitions>
        <GridView.ItemTemplate>
          <DataTemplate>
            <!-- Named and id'd so a tile is addressable by identity rather than by position or by a
                 display name that two sources can share. -->
            <Border Width="300" Height="86" Margin="0,0,14,14" Padding="16"
                    Style="{StaticResource MediaHubCard}"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.HelpText="{Binding KindLabel}">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                        Background="{StaticResource MediaHubAccentSoftBrush}">
                  <FontIcon Glyph="&#xE8B7;" FontSize="15"
                            Foreground="{StaticResource MediaHubAccentBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MediaHubCaption}" />
                    <TextBlock Text="·" Style="{StaticResource MediaHubCaption}" />
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource MediaHubCaption}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ItemsControl x:Name="SkeletonPanel" Visibility="Collapsed" IsHitTestVisible="False"
                    ItemTemplate="{StaticResource MediaHubCardSkeleton}"
                    ItemsPanel="{StaticResource MediaHubSkeletonCardPanel}" />

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="14" Visibility="Collapsed" MaxWidth="460">
        <Border Style="{StaticResource MediaHubStateIcon}">
          <FontIcon Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE8B7;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Style="{StaticResource MediaHubStateTitle}" Text="还没有可用的媒体库" />
          <TextBlock Style="{StaticResource MediaHubStateDescription}"
                     Text="在“媒体源”中添加并登录 Emby、Jellyfin 或 WebDAV 服务器后，媒体库会列在这里。" />
        </StackPanel>
        <Button Content="前往媒体源" HorizontalAlignment="Center" Click="OnAddSourceClick"
                Style="{StaticResource MediaHubPrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
