<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MediaHubGlassPageBrush}">

  <Grid x:Name="RootGrid" Padding="36,28,36,24" RowSpacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="860" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="20,16,20,16" />
            <!-- Three actions cannot sit beside the title in a narrow window; below it they stay
                 reachable instead of being clipped at the right edge. -->
            <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
            <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
            <Setter Target="HeaderActions.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="16" RowSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" MaxWidth="820">
        <TextBlock Text="媒体源" Style="{StaticResource MediaHubPageTitle}" />
        <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                   Text="账号密码与会话令牌保存在 Windows DPAPI（当前用户）加密的凭据库中，不写入普通配置文件。删除媒体源会同时清除对应凭据。" />
      </StackPanel>
      <StackPanel x:Name="HeaderActions" Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
        <Button x:Name="RefreshButton" Click="OnRefreshClick" Style="{StaticResource MediaHubGhostButton}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="全部重新检测" />
          </StackPanel>
        </Button>
        <Button x:Name="AddButton" Click="OnAddClick" Style="{StaticResource MediaHubPrimaryButton}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="13" />
            <TextBlock Text="添加媒体源" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <Grid Grid.Row="2">
      <ListView x:Name="ServerList" SelectionMode="None"
                HorizontalContentAlignment="Stretch"
                ItemContainerStyle="{StaticResource MediaHubListViewItem}">
        <ListView.ItemContainerTransitions>
          <TransitionCollection>
            <AddDeleteThemeTransition />
            <RepositionThemeTransition />
          </TransitionCollection>
        </ListView.ItemContainerTransitions>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10" Padding="18" Style="{StaticResource MediaHubCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding StatusBrush}" />

                <StackPanel Grid.Column="1" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                    <Border Padding="7,1" CornerRadius="999" VerticalAlignment="Center"
                            Background="{StaticResource MediaHubSurfaceHoverBrush}">
                      <TextBlock Text="{Binding TypeName}" FontSize="11"
                                 Foreground="{StaticResource MediaHubTextSecondaryBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Url}" Style="{StaticResource MediaHubCaption}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CapabilitySummary}" Style="{StaticResource MediaHubCaption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="8" MinWidth="150">
                  <Button Content="测试连接" Tag="{Binding}" Click="OnTestClick" HorizontalAlignment="Stretch"
                          Style="{StaticResource MediaHubGhostButton}" />
                  <Button Content="重新登录" Tag="{Binding}" Click="OnReconnectClick" HorizontalAlignment="Stretch"
                          Visibility="{Binding ReconnectVisibility}"
                          Style="{StaticResource MediaHubGhostButton}" />
                  <Button Content="删除" Tag="{Binding}" Click="OnDeleteClick" HorizontalAlignment="Stretch"
                          Style="{StaticResource MediaHubGhostButton}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="14" Visibility="Collapsed" MaxWidth="460">
        <Border Style="{StaticResource MediaHubStateIcon}">
          <FontIcon Style="{StaticResource MediaHubStateGlyph}" Glyph="&#xE774;" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Style="{StaticResource MediaHubStateTitle}" Text="还没有添加媒体源" />
          <TextBlock Style="{StaticResource MediaHubStateDescription}"
                     Text="添加 Emby、Jellyfin、WebDAV 服务器、SMB 共享（\\主机\共享）、OneDrive 或 http(s) 直链/播放列表后，媒体库与搜索就会使用它。本地文件夹可在“本地媒体”中添加。" />
        </StackPanel>
        <Button Content="添加媒体源" HorizontalAlignment="Center" Click="OnAddClick"
                Style="{StaticResource MediaHubPrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
