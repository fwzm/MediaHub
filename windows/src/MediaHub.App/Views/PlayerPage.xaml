<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

  <Grid x:Name="Root" Background="Black">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TopRow" Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition x:Name="BottomRow" Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top chrome. Sits outside the video rectangle: a foreign child HWND is composited above the
         XAML island, so anything drawn over the video area would be invisible.
         The bottom hairline is what makes the bar read as a separate plane from the video instead of
         fading into it; the bar itself stays a near-opaque gradient because it is opaque chrome, not
         a window over the picture. -->
    <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource MediaHubTopOverlayBrush}" Padding="18,8"
            BorderBrush="{StaticResource MediaHubOverlayHairlineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" Grid.Column="0" Click="OnBackClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="返回" AutomationProperties.AutomationId="player.back"
                Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="返回 (Esc)">
          <FontIcon Glyph="&#xE72B;" />
        </Button>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                     FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
          <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
          <!-- Visible rather than a tooltip: "what plays next" is a question the user asks before the
               current item ends, and a tooltip answers it only while the pointer happens to hover. -->
          <TextBlock x:Name="QueueNextTitle" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="Collapsed"
                     AutomationProperties.AutomationId="player.queuenexttitle" />
          <TextBlock x:Name="ScreenshotToast" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="Collapsed"
                     AutomationProperties.AutomationId="player.screenshottip" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <!-- Read-only badge, not a control: it answers "am I watching a transcode right now", which
               is what the toggle next to it cannot show once the controls auto-hide. -->
          <Border x:Name="TranscodeBadge" Margin="0,0,6,0" Padding="6,2" CornerRadius="999"
                  VerticalAlignment="Center" Visibility="Collapsed"
                  Background="{StaticResource MediaHubOverlayHairlineBrush}">
            <TextBlock Text="转码" FontSize="11" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                       AutomationProperties.Name="正在转码"
                       AutomationProperties.AutomationId="player.transcodebadge" />
          </Border>
          <TextBlock x:Name="QueueCountText" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"
                     Margin="0,0,4,0"
                     Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     AutomationProperties.AutomationId="player.queuecount" />
          <Button x:Name="QueuePrevButton" Click="OnQueuePrevClick" Style="{StaticResource MediaHubIconButton}"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="上一项"
                  AutomationProperties.Name="上一项" AutomationProperties.AutomationId="player.queueprev">
            <FontIcon Glyph="&#xE100;" FontSize="15" />
          </Button>
          <Button x:Name="QueueNextButton" Click="OnQueueNextClick" Style="{StaticResource MediaHubIconButton}"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="下一项"
                  AutomationProperties.Name="下一项" AutomationProperties.AutomationId="player.queuenext">
            <FontIcon Glyph="&#xE101;" FontSize="15" />
          </Button>
          <Border Width="1" Height="18" Margin="6,0" VerticalAlignment="Center"
                  Background="{StaticResource MediaHubOverlayHairlineBrush}" />
          <Button x:Name="QueuePanelButton" Click="OnQueuePanelClick" Style="{StaticResource MediaHubIconButton}"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="播放队列"
                  AutomationProperties.Name="播放队列" AutomationProperties.AutomationId="player.queuepanel">
            <FontIcon Glyph="&#xE8FD;" FontSize="15" />
          </Button>
          <Button x:Name="ShortcutsButton" Click="OnShortcutsClick" Style="{StaticResource MediaHubIconButton}"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="快捷键与操作 (?)"
                  AutomationProperties.Name="快捷键与操作" AutomationProperties.AutomationId="player.shortcuts">
            <FontIcon Glyph="&#xE765;" FontSize="15" />
          </Button>
          <ToggleButton x:Name="InfoToggle" Click="OnInfoToggleClick" Background="Transparent"
                        Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="媒体信息 (I)">
            <FontIcon Glyph="&#xE946;" FontSize="15" />
          </ToggleButton>
          <ToggleButton x:Name="TranscodeToggle" Click="OnTranscodeToggleClick" Background="Transparent"
                        Foreground="{StaticResource MediaHubOverlayTextBrush}"
                        ToolTipService.ToolTip="强制转码（HLS，本次播放有效）" Visibility="Collapsed"
                        AutomationProperties.Name="强制转码"
                        AutomationProperties.AutomationId="player.transcode">
            <FontIcon Glyph="&#xE895;" FontSize="15" />
          </ToggleButton>
          <Button x:Name="ScreenshotButton" Click="OnScreenshotClick" Style="{StaticResource MediaHubIconButton}"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="截图（保存到图片\MediaHub 截图）"
                  AutomationProperties.Name="截图" AutomationProperties.AutomationId="player.screenshot"
                  Visibility="Collapsed">
            <FontIcon Glyph="&#xE722;" FontSize="15" />
          </Button>
          <Border Width="1" Height="18" Margin="6,0" VerticalAlignment="Center"
                  Background="{StaticResource MediaHubOverlayHairlineBrush}" />
          <Button x:Name="FullscreenButton" Click="OnFullscreenClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="全屏" AutomationProperties.AutomationId="player.fullscreen"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="全屏 (F11)">
            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Video row: the engine's native surface is positioned over the left cell; the side panel
         lives in its own column so it is never occluded. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="VideoHost" Grid.Column="0" Background="Black" IsTabStop="True"
            AutomationProperties.AutomationId="player.videohost"
            DoubleTapped="OnVideoHostDoubleTapped">
        <!-- Intentionally empty: this rectangle is covered by the native surface while playing.
             Status text is shown only when the surface is hidden (no media / error). -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressRing x:Name="LoadingRing" IsActive="True" Width="42" Height="42" Foreground="White" />
          <TextBlock x:Name="StatusText" Foreground="White" Text="正在打开媒体…" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Border x:Name="SidePanel" Grid.Column="1" Background="{StaticResource MediaHubPlayerPanelBrush}"
              BorderBrush="{StaticResource MediaHubOverlayHairlineBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer Padding="20">
          <StackPanel Spacing="18">
            <TextBlock x:Name="PanelHeader" Style="{StaticResource MediaHubSectionHeader}" Text="媒体信息" />

            <StackPanel x:Name="InfoSection" Spacing="6">
              <ItemsControl x:Name="InfoList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MediaHubCaption}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="显示为“未知”的项目表示播放引擎未上报该信息，MediaHub 不会推测填充。" />

              <!-- Versions only exist when the server holds more than one file for this item; the
                   section stays collapsed otherwise rather than showing a one-entry picker. -->
              <StackPanel x:Name="VersionSection" Spacing="6" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="版本" FontWeight="SemiBold" />
                <ListView x:Name="VersionList" SelectionMode="Single" SelectionChanged="OnVersionSelectionChanged"
                          MaxHeight="180" AutomationProperties.AutomationId="panel.version" />
                <TextBlock x:Name="VersionHint" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="panel.versionhint" />
              </StackPanel>
            </StackPanel>

            <!--
              The AutomationId sits on the ListView, not on the section panel. A bare StackPanel has no
              automation peer, so an id placed on it never appears in the UI Automation tree at all -
              which makes "the panel is open" unobservable from outside the process.
            -->
            <StackPanel x:Name="VideoSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="视频轨" FontWeight="SemiBold" />
              <ListView x:Name="VideoList" SelectionMode="Single" SelectionChanged="OnVideoSelectionChanged"
                        MaxHeight="220" AutomationProperties.AutomationId="panel.video" />
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="选择会按剧集系列记住，下一集沿用同一条轨道。" />
            </StackPanel>

            <StackPanel x:Name="AudioSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="音轨" FontWeight="SemiBold" />
              <ListView x:Name="AudioList" SelectionMode="Single" SelectionChanged="OnAudioSelectionChanged"
                        AutomationProperties.AutomationId="panel.audio" />
              <TextBlock Text="输出设备" FontWeight="SemiBold" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="PlayerAudioDeviceCombo" MinWidth="220" CornerRadius="10"
                          DisplayMemberPath="Description"
                          SelectionChanged="OnPlayerAudioDeviceChanged"
                          AutomationProperties.AutomationId="panel.audiodevice" />
                <Button Content="刷新" Click="OnRefreshAudioDevicesClick" />
              </StackPanel>
              <TextBlock x:Name="PlayerAudioDeviceHint" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="panel.audiodevicehint" />
            </StackPanel>

            <StackPanel x:Name="SubtitleSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="字幕" FontWeight="SemiBold" />
              <ListView x:Name="SubtitleList" SelectionMode="Single" SelectionChanged="OnSubtitleSelectionChanged"
                        AutomationProperties.AutomationId="panel.subtitle" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="加载外挂字幕…" Click="OnLoadSubtitleClick" />
                <Button Content="重新选择文件" Click="OnReloadSubtitleClick" />
              </StackPanel>
              <!-- Style controls live here as well as in Settings so a change can be judged on the
                   moving picture; the settings page is unreachable while the player covers the shell. -->
              <TextBlock Text="字幕样式" FontWeight="SemiBold" Margin="0,8,0,0" />
              <Grid>
                <TextBlock Text="字号" Style="{StaticResource MediaHubCaption}" />
                <TextBlock Text="{Binding Value, ElementName=PlayerSubtitleSizeSlider}" HorizontalAlignment="Right"
                           Style="{StaticResource MediaHubMono}" />
              </Grid>
              <Slider x:Name="PlayerSubtitleSizeSlider" Minimum="20" Maximum="120" StepFrequency="1"
                      ValueChanged="OnPlayerSubtitleSizeChanged" AutomationProperties.AutomationId="panel.subtitlesize" />
              <ComboBox x:Name="PlayerSubtitleColorCombo" MinWidth="180" CornerRadius="10"
                        SelectionChanged="OnPlayerSubtitleColorChanged"
                        AutomationProperties.AutomationId="panel.subtitlecolor" />
              <Grid>
                <TextBlock Text="描边" Style="{StaticResource MediaHubCaption}" />
                <TextBlock Text="{Binding Value, ElementName=PlayerSubtitleBorderSlider}" HorizontalAlignment="Right"
                           Style="{StaticResource MediaHubMono}" />
              </Grid>
              <Slider x:Name="PlayerSubtitleBorderSlider" Minimum="0" Maximum="10" StepFrequency="0.5"
                      ValueChanged="OnPlayerSubtitleBorderChanged" AutomationProperties.AutomationId="panel.subtitleborder" />
              <Grid>
                <TextBlock Text="底部偏移" Style="{StaticResource MediaHubCaption}" />
                <TextBlock Text="{Binding Value, ElementName=PlayerSubtitlePositionSlider}" HorizontalAlignment="Right"
                           Style="{StaticResource MediaHubMono}" />
              </Grid>
              <!-- 100 keeps the subtitle where the track puts it; smaller values lift it towards the
                   middle of the frame, which is the only way to move an authored ASS line. -->
              <Slider x:Name="PlayerSubtitlePositionSlider" Minimum="10" Maximum="150" StepFrequency="1"
                      ValueChanged="OnPlayerSubtitlePositionChanged" AutomationProperties.AutomationId="panel.subtitleposition" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="PlayerSubtitleBoldToggle" Content="加粗"
                              Click="OnPlayerSubtitleBoldClick"
                              AutomationProperties.AutomationId="panel.subtitlebold" />
                <Button Content="恢复默认样式" Click="OnResetSubtitleStyleClick" />
              </StackPanel>
              <TextBlock x:Name="SubtitleHint" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="player.subtitlehint" />
            </StackPanel>

            <StackPanel x:Name="QueueSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="播放队列" FontWeight="SemiBold" />
              <ListView x:Name="QueueList" SelectionMode="Single" SelectionChanged="OnQueueSelectionChanged"
                        MaxHeight="360" AutomationProperties.AutomationId="panel.queue" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="QueuePlayButton" Content="播放所选" Click="OnQueuePlaySelectedClick"
                        AutomationProperties.AutomationId="player.queueplay" />
                <Button x:Name="QueueRemoveButton" Content="移除所选" Click="OnQueueRemoveClick"
                        AutomationProperties.AutomationId="player.queueremove" />
                <Button x:Name="QueueClearButton" Content="清空队列" Click="OnQueueClearClick"
                        AutomationProperties.AutomationId="player.queueclear" />
              </StackPanel>
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="队列只存在于本次会话，不会被保存成播放列表。" />
            </StackPanel>

            <StackPanel x:Name="ShortcutsSection" Spacing="6" Visibility="Collapsed"
                        AutomationProperties.AutomationId="panel.shortcuts">
              <TextBlock Text="快捷键与操作" FontWeight="SemiBold" />
              <!-- Rows are built in code from PlayerShortcutCatalog so this sheet cannot drift away
                   from the handlers it documents. -->
              <StackPanel x:Name="ShortcutsStack" Spacing="8" />
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="↑ / ↓ 与滚轮按指针所在半屏决定调亮度还是音量。" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom control bar. Same rule as the top bar: a hairline separates it from the video, and the
         fill stays near-opaque so position text and the seek slider are legible over any frame. -->
    <Border x:Name="BottomBar" Grid.Row="2" Background="{StaticResource MediaHubBottomOverlayBrush}" Padding="18,10"
            BorderBrush="{StaticResource MediaHubOverlayHairlineBrush}" BorderThickness="0,1,0,0">
      <Grid RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" Grid.Column="0" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                     VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Text="0:00" MinWidth="56" />
          <!-- The seek control needs an identity of its own. Without one, a test can only reach it
               through the surrounding layout, and an earlier run of the Seek check silently degraded
               into measuring natural playback advance while reporting as though it had seeked. -->
          <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.0001"
                  VerticalAlignment="Center" ValueChanged="OnSeekValueChanged"
                  AutomationProperties.Name="播放进度"
                  AutomationProperties.AutomationId="player.seekslider" />
          <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Text="0:00" MinWidth="56" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="播放暂停" AutomationProperties.AutomationId="player.playpause"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="播放/暂停 (空格)">
              <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
            </Button>
            <Button x:Name="PrevEpisodeButton" Click="OnPreviousEpisodeClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="上一集" AutomationProperties.AutomationId="player.prevepisode"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="上一集"
                    Visibility="Collapsed">
              <FontIcon Glyph="&#xE100;" FontSize="15" />
            </Button>
            <Button x:Name="NextEpisodeButton" Click="OnNextEpisodeClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="下一集" AutomationProperties.AutomationId="player.nextepisode"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="下一集"
                    Visibility="Collapsed">
              <FontIcon Glyph="&#xE101;" FontSize="15" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="MuteButton" Click="OnMuteClick" Style="{StaticResource MediaHubIconButton}"
          AutomationProperties.Name="静音" AutomationProperties.AutomationId="player.mute"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="静音 (M)">
              <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" />
            </Button>
            <Slider x:Name="VolumeSlider" Width="118" Minimum="0" Maximum="200" Value="100"
                    VerticalAlignment="Center" ValueChanged="OnVolumeValueChanged" />
          </StackPanel>

          <ComboBox x:Name="SpeedCombo" Grid.Column="2" Width="92" VerticalAlignment="Center"
                    CornerRadius="10" SelectionChanged="OnSpeedComboChanged" ToolTipService.ToolTip="播放速度" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
            <Button Click="OnVideoPanelClick" Style="{StaticResource MediaHubIconButton}"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}"
                    AutomationProperties.Name="视频轨" AutomationProperties.AutomationId="player.videopanel"
                    ToolTipService.ToolTip="视频轨">
              <FontIcon Glyph="&#xE714;" FontSize="15" />
            </Button>
            <Button Click="OnAudioPanelClick" Style="{StaticResource MediaHubIconButton}"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}"
                    AutomationProperties.Name="音轨" AutomationProperties.AutomationId="player.audiopanel"
                    ToolTipService.ToolTip="音轨">
              <FontIcon Glyph="&#xE8D6;" FontSize="15" />
            </Button>
            <Button Click="OnSubtitlePanelClick" Style="{StaticResource MediaHubIconButton}"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}"
                    AutomationProperties.Name="字幕" AutomationProperties.AutomationId="player.subtitlepanel"
                    ToolTipService.ToolTip="字幕">
              <FontIcon Glyph="&#xED1E;" FontSize="15" />
            </Button>
          </StackPanel>

          <TextBlock x:Name="TechnicalSummary" Grid.Column="4" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
