<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaHub.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

  <Grid x:Name="Root" Background="Black">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TopRow" Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition x:Name="BottomRow" Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top chrome. Sits outside the video rectangle: a foreign child HWND is composited above the
         XAML island, so anything drawn over the video area would be invisible. -->
    <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource MediaHubOverlayBrush}" Padding="8,6">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" Grid.Column="0" Click="OnBackClick" Background="Transparent"
          AutomationProperties.Name="返回" AutomationProperties.AutomationId="player.back"
                Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="返回 (Esc)">
          <FontIcon Glyph="&#xE72B;" />
        </Button>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
          <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
          <!-- Visible rather than a tooltip: "what plays next" is a question the user asks before the
               current item ends, and a tooltip answers it only while the pointer happens to hover. -->
          <TextBlock x:Name="QueueNextTitle" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="Collapsed"
                     AutomationProperties.AutomationId="player.queuenexttitle" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="QueueCountText" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"
                     Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     AutomationProperties.AutomationId="player.queuecount" />
          <Button x:Name="QueuePrevButton" Click="OnQueuePrevClick" Background="Transparent"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="上一项"
                  AutomationProperties.Name="上一项" AutomationProperties.AutomationId="player.queueprev">
            <FontIcon Glyph="&#xE100;" />
          </Button>
          <Button x:Name="QueueNextButton" Click="OnQueueNextClick" Background="Transparent"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="下一项"
                  AutomationProperties.Name="下一项" AutomationProperties.AutomationId="player.queuenext">
            <FontIcon Glyph="&#xE101;" />
          </Button>
          <Button x:Name="QueuePanelButton" Click="OnQueuePanelClick" Background="Transparent"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="播放队列"
                  AutomationProperties.Name="播放队列" AutomationProperties.AutomationId="player.queuepanel">
            <FontIcon Glyph="&#xE8FD;" />
          </Button>
          <ToggleButton x:Name="InfoToggle" Click="OnInfoToggleClick" Background="Transparent"
                        Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="媒体信息 (I)">
            <FontIcon Glyph="&#xE946;" />
          </ToggleButton>
          <Button x:Name="FullscreenButton" Click="OnFullscreenClick" Background="Transparent"
          AutomationProperties.Name="全屏" AutomationProperties.AutomationId="player.fullscreen"
                  Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="全屏 (F11)">
            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Video row: the engine's native surface is positioned over the left cell; the side panel
         lives in its own column so it is never occluded. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="VideoHost" Grid.Column="0" Background="Black" IsTabStop="True"
            DoubleTapped="OnVideoHostDoubleTapped">
        <!-- Intentionally empty: this rectangle is covered by the native surface while playing.
             Status text is shown only when the surface is hidden (no media / error). -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressRing x:Name="LoadingRing" IsActive="True" Width="42" Height="42" Foreground="White" />
          <TextBlock x:Name="StatusText" Foreground="White" Text="正在打开媒体…" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Border x:Name="SidePanel" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer Padding="16">
          <StackPanel Spacing="16">
            <TextBlock x:Name="PanelHeader" Style="{StaticResource MediaHubSectionHeader}" Text="媒体信息" />

            <StackPanel x:Name="InfoSection" Spacing="6">
              <ItemsControl x:Name="InfoList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MediaHubCaption}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="显示为“未知”的项目表示播放引擎未上报该信息，MediaHub 不会推测填充。" />
            </StackPanel>

            <!--
              The AutomationId sits on the ListView, not on the section panel. A bare StackPanel has no
              automation peer, so an id placed on it never appears in the UI Automation tree at all -
              which makes "the panel is open" unobservable from outside the process.
            -->
            <StackPanel x:Name="AudioSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="音轨" FontWeight="SemiBold" />
              <ListView x:Name="AudioList" SelectionMode="Single" SelectionChanged="OnAudioSelectionChanged"
                        AutomationProperties.AutomationId="panel.audio" />
            </StackPanel>

            <StackPanel x:Name="SubtitleSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="字幕" FontWeight="SemiBold" />
              <ListView x:Name="SubtitleList" SelectionMode="Single" SelectionChanged="OnSubtitleSelectionChanged"
                        AutomationProperties.AutomationId="panel.subtitle" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="加载外挂字幕…" Click="OnLoadSubtitleClick" />
                <Button Content="重新选择文件" Click="OnReloadSubtitleClick" />
              </StackPanel>
              <TextBlock x:Name="SubtitleHint" Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="player.subtitlehint" />
            </StackPanel>

            <StackPanel x:Name="QueueSection" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="播放队列" FontWeight="SemiBold" />
              <ListView x:Name="QueueList" SelectionMode="Single" SelectionChanged="OnQueueSelectionChanged"
                        MaxHeight="360" AutomationProperties.AutomationId="panel.queue" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="QueuePlayButton" Content="播放所选" Click="OnQueuePlaySelectedClick"
                        AutomationProperties.AutomationId="player.queueplay" />
                <Button x:Name="QueueRemoveButton" Content="移除所选" Click="OnQueueRemoveClick"
                        AutomationProperties.AutomationId="player.queueremove" />
                <Button x:Name="QueueClearButton" Content="清空队列" Click="OnQueueClearClick"
                        AutomationProperties.AutomationId="player.queueclear" />
              </StackPanel>
              <TextBlock Style="{StaticResource MediaHubCaption}" TextWrapping="Wrap"
                         Text="队列只存在于本次会话，不会被保存成播放列表。" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom control bar. -->
    <Border x:Name="BottomBar" Grid.Row="2" Background="{StaticResource MediaHubOverlayBrush}" Padding="12,8">
      <Grid RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" Grid.Column="0" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                     VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Text="0:00" MinWidth="56" />
          <!-- The seek control needs an identity of its own. Without one, a test can only reach it
               through the surrounding layout, and an earlier run of the Seek check silently degraded
               into measuring natural playback advance while reporting as though it had seeked. -->
          <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.0001"
                  VerticalAlignment="Center" ValueChanged="OnSeekValueChanged"
                  AutomationProperties.Name="播放进度"
                  AutomationProperties.AutomationId="player.seekslider" />
          <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Text="0:00" MinWidth="56" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Background="Transparent"
          AutomationProperties.Name="播放暂停" AutomationProperties.AutomationId="player.playpause"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="播放/暂停 (空格)">
              <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
            </Button>
            <Button Click="OnSeekBackClick" Background="Transparent" Foreground="{StaticResource MediaHubOverlayTextBrush}"
          AutomationProperties.Name="快退" AutomationProperties.AutomationId="player.seekback"
                    ToolTipService.ToolTip="后退 10 秒 (←)">
              <FontIcon Glyph="&#xE892;" />
            </Button>
            <Button Click="OnSeekForwardClick" Background="Transparent" Foreground="{StaticResource MediaHubOverlayTextBrush}"
          AutomationProperties.Name="快进" AutomationProperties.AutomationId="player.seekforward"
                    ToolTipService.ToolTip="前进 10 秒 (→)">
              <FontIcon Glyph="&#xE893;" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="MuteButton" Click="OnMuteClick" Background="Transparent"
          AutomationProperties.Name="静音" AutomationProperties.AutomationId="player.mute"
                    Foreground="{StaticResource MediaHubOverlayTextBrush}" ToolTipService.ToolTip="静音 (M)">
              <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" />
            </Button>
            <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="200" Value="100"
                    VerticalAlignment="Center" ValueChanged="OnVolumeValueChanged" />
          </StackPanel>

          <ComboBox x:Name="SpeedCombo" Grid.Column="2" Width="92" VerticalAlignment="Center"
                    SelectionChanged="OnSpeedComboChanged" ToolTipService.ToolTip="播放速度" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
            <Button Click="OnAudioPanelClick" Background="Transparent" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                    AutomationProperties.Name="音轨" AutomationProperties.AutomationId="player.audiopanel"
                    ToolTipService.ToolTip="音轨">
              <FontIcon Glyph="&#xE8D6;" />
            </Button>
            <Button Click="OnSubtitlePanelClick" Background="Transparent" Foreground="{StaticResource MediaHubOverlayTextBrush}"
                    AutomationProperties.Name="字幕" AutomationProperties.AutomationId="player.subtitlepanel"
                    ToolTipService.ToolTip="字幕">
              <FontIcon Glyph="&#xED1E;" />
            </Button>
          </StackPanel>

          <TextBlock x:Name="TechnicalSummary" Grid.Column="4" Foreground="{StaticResource MediaHubOverlaySubtleTextBrush}"
                     VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
