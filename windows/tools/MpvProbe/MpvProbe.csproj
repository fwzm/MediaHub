<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>MediaHub.Tools.MpvProbe</RootNamespace>
    <LibMpvDir Condition="'$(LibMpvDir)' == ''">$(MSBuildThisFileDirectory)..\..\native\libmpv</LibMpvDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaHub.Player.Mpv\MediaHub.Player.Mpv.csproj" />
  </ItemGroup>
  <Target Name="VerifyLibMpv" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LibMpvDir)\libmpv-2.dll')"
           Text="libmpv-2.dll not found in '$(LibMpvDir)'. Run: pwsh -File windows/tools/fetch-libmpv.ps1" />
  </Target>
</Project>
