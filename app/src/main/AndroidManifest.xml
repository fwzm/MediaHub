<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        usesCleartextTraffic：Phase 0 允许 HTTP（局域网 Emby/Jellyfin/WebDAV）。
        后续应替换为 networkSecurityConfig，按域名/网段精确放行 cleartext（见 TASKS.md）。
    -->
    <application
        android:name=".MediaHubApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaHub"
        android:usesCleartextTraffic="true">

        <!--
            configChanges：播放器经 requestedOrientation 控制横竖屏，旋转时避免 Activity 重建
            （重建会导致播放器被 onDispose 释放、ViewModel 重建、重新 resolve 播放源的双播放器问题）。
            Compose 经 LocalConfiguration 自适应尺寸，无需重建。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
